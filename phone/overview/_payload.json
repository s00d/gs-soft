152],"tr",{},[147,148],"th",{},[147,150,151],{},"Desktop gateway",[147,153,83],{},[155,156,157,169,180,191],"tbody",{},[144,158,159,163,166],{},[160,161,162],"td",{},"SIM cards",[160,164,165],{},"USB modems",[160,167,168],{},"The phone's own SIM slots (dual SIM included)",[144,170,171,174,177],{},[160,172,173],{},"Runs on",[160,175,176],{},"Windows, macOS, Linux",[160,178,179],{},"Android 8.0+",[144,181,182,185,188],{},[160,183,184],{},"Account",[160,186,187],{},"Seller account",[160,189,190],{},"The same seller account",[144,192,193,195,198],{},[160,194,46],{},[160,196,197],{},"Automatic",[160,199,200],{},"Automatic, from the same release",[202,203,205],"h2",{"id":204},"how-it-works","How it works",[207,208,209,213,216],"ul",{},[210,211,212],"li",{},"A background service keeps the connection to the server and survives the screen being off; the\napp's watchdog restarts it if Android stops it.",[210,214,215],{},"SMS are written to the phone's storage first and sent to the server as soon as it answers, so\nnothing is lost when the connection drops.",[210,217,218,219,223],{},"A SIM inserted later is listed by itself; ",[220,221,222],"strong",{},"Log out"," takes the numbers off sale.",[134,225,226,227,230],{},"Next: ",[228,229,93],"a",{"href":94},".",{"title":232,"searchDepth":233,"depth":233,"links":234},"",2,[235],{"id":204,"depth":233,"text":205},"An Android app that turns a phone into a standalone gateway selling its own SIM cards.","md",null,{},{"title":89,"icon":84},{"title":83,"description":236},"6gYXBICgiFxjVzWCUQCzIrNWrW2gMPcL4GV9KcyOPFA",[238,244],{"title":93,"path":94,"description":245},"Installing the APK, the permissions checklist, device owner mode and logging in.",1794978317850]