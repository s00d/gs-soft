ition",[143,144,145,153,164],"card-group",{},[146,147,150],"card",{"icon":148,"title":149,"to":17},"i-lucide-monitor","Desktop app",[134,151,152],{},"Windows, macOS, Linux. The full operator UI in a window, with a tray icon and notifications.",[146,154,156],{"icon":58,"title":155,"to":64},"Headless gateway",[134,157,158,159,163],{},"The same install started with ",[160,161,162],"code",{},"--serve",": no window, a Web UI in the browser. For servers and mini PCs.",[146,165,166],{"icon":84,"title":83,"to":90},[134,167,168],{},"An Android app that sells the phone's own SIM cards. No computer or USB modem needed.",[134,170,171,172,177],{},"All three come from the same ",[173,174,176],"a",{"href":175},"\u002Fdownloads","release"," and update themselves.",[138,179,181],{"id":180},"three-steps","Three steps",[183,184,186,190,200,204,207,211],"steps",{"level":185},"3",[187,188,16],"h3",{"id":189},"install",[134,191,192,193,196,197,199],{},"Download the installer for your system on the ",[173,194,195],{"href":175},"downloads page"," and run it. Details per\nsystem: ",[173,198,16],{"href":17},".",[187,201,203],{"id":202},"log-in","Log in",[134,205,206],{},"Open the app and sign in with the email and password of your seller account. The gateway keeps the\nsession: after a restart it reconnects by itself.",[187,208,210],{"id":209},"add-the-modems","Add the modems",[134,212,213,214,218,219,199],{},"Plug the modems in, open ",[215,216,217],"strong",{},"Ports list → Add"," and pick their ports. From then on the gateway\nreconnects them on every start, reads the SIM cards and puts the numbers on sale. See\n",[173,220,21],{"href":22},[222,223,224],"tip",{},[134,225,226,227,230],{},"A dedicated machine that only runs the gateway is easier to keep online as a\n",[173,228,229],{"href":64},"headless gateway"," started as a system service.",{"title":232,"searchDepth":233,"depth":233,"links":234},"",2,[235,236],{"id":140,"depth":233,"text":141},{"id":180,"depth":233,"text":181,"children":237},[238,240,241],{"id":189,"depth":239,"text":16},3,{"id":202,"depth":239,"text":203},{"id":209,"depth":239,"text":210},"What Gateway Soft is, which edition to install and the three steps to the first number on sale.","md",null,{},{"icon":14},{"title":11,"description":242},"eqv8rpYv_NHV631awPXch67bqkMwjT2HZOGCU0Z2a2k",[244,250],{"title":16,"path":17,"description":251},"Installers for Windows, macOS and Linux, which file to pick and where the gateway keeps its data.",1794978317772]