ce","\u002Fheadless\u002Fservice","2.headless\u002F3.service","i-lucide-server-cog",{"title":78,"path":79,"stem":80,"icon":81},"Network ports","\u002Fheadless\u002Fnetwork-ports","2.headless\u002F4.network-ports","i-lucide-network",{"title":83,"icon":84,"path":85,"stem":86,"children":87,"page":55},"Gateway Phone","i-lucide-smartphone","\u002Fphone","3.phone",[88,92],{"title":89,"path":90,"stem":91,"icon":84},"Overview","\u002Fphone\u002Foverview","3.phone\u002F1.overview",{"title":93,"path":94,"stem":95,"icon":96},"Install and set up","\u002Fphone\u002Fsetup","3.phone\u002F2.setup","i-lucide-list-checks",{"title":98,"icon":81,"path":99,"stem":100,"children":101,"page":55},"Gateway Proxy","\u002Fproxy","4.proxy",[102,105],{"title":89,"path":103,"stem":104,"icon":81},"\u002Fproxy\u002Foverview","4.proxy\u002F1.overview",{"title":93,"path":106,"stem":107,"icon":96},"\u002Fproxy\u002Fsetup","4.proxy\u002F2.setup",{"title":109,"icon":110,"path":111,"stem":112,"children":113,"page":55},"Hardware","i-lucide-cpu","\u002Fhardware","5.hardware",[114,118],{"title":115,"path":116,"stem":117,"icon":110},"Supported modems","\u002Fhardware\u002Fmodems","5.hardware\u002F1.modems",{"title":119,"path":120,"stem":121,"icon":122},"Drivers","\u002Fhardware\u002Fdrivers","5.hardware\u002F2.drivers","i-lucide-usb",{"title":124,"path":125,"stem":126,"icon":127},"FAQ","\u002Ffaq","6.faq","i-lucide-circle-help",{"id":129,"title":26,"body":130,"description":299,"extension":300,"links":301,"meta":302,"navigation":303,"path":27,"seo":304,"stem":28,"__hash__":305},"docs_en\u002F1.guide\u002F4.selling.md",{"type":131,"value":132,"toc":291},"minimark",[133,138,173,184,188,194,198,273,280,284],[134,135,137],"h2",{"id":136},"from-sim-to-sale","From SIM to sale",[139,140,141,150,170],"ol",{},[142,143,144,145,149],"li",{},"The gateway reads the SIM (IMSI, ICCID) and finds the number: from the SIM itself, from its phone\nbook, or with the operator's USSD request (",[146,147,148],"code",{},"*…#","). The number can always be typed in the detail\npanel.",[142,151,152,153,157,158,161,162,165,166,169],{},"With ",[154,155,156],"strong",{},"Auto-connect"," on (",[154,159,160],{},"Settings → General","), the number is sent to the server and the port goes\n",[154,163,164],{},"Queued",", then ",[154,167,168],{},"Online"," once the server starts selling it.",[142,171,172],{},"Buyers' SMS arrive at the modem; the gateway forwards them to the server at once. SMS that arrive\nwhile the server is unreachable are kept and sent later.",[174,175,176],"tip",{},[177,178,179,180,183],"p",{},"Leave auto-connect off to check new SIMs first; then put single ports on sale with ",[154,181,182],{},"Reset errors\nand reconnect",".",[134,185,187],{"id":186},"rent","Rent",[177,189,190,191,193],{},"The ",[154,192,187],{}," switch in the detail panel offers the number for long-term rent as well as for single\nactivations. The choice is kept per port across restarts.",[134,195,197],{"id":196},"server-answers","Server answers",[199,200,201,217],"table",{},[202,203,204],"thead",{},[205,206,207,211,214],"tr",{},[208,209,210],"th",{},"Shown",[208,212,213],{},"What happened",[208,215,216],{},"What to do",[218,219,220,234,247,260],"tbody",{},[205,221,222,228,231],{},[223,224,225],"td",{},[154,226,227],{},"Number reused",[223,229,230],{},"The server refuses rent for a number that already worked for activations.",[223,232,233],{},"Turn rent off for this port.",[205,235,236,241,244],{},[223,237,238],{},[154,239,240],{},"Number banned",[223,242,243],{},"The number collected too many failed activations.",[223,245,246],{},"The server lifts bans at its nightly reset.",[205,248,249,254,257],{},[223,250,251],{},[154,252,253],{},"Service banned",[223,255,256],{},"One service (for example a messenger) blocked the number.",[223,258,259],{},"Nothing; the number keeps selling to other services.",[205,261,262,267,270],{},[223,263,264],{},[154,265,266],{},"Port disabled",[223,268,269],{},"The server turned the listing off.",[223,271,272],{},"Check the number and the account; then reconnect.",[177,274,275,276,279],{},"A port the server refused is not sent again by the auto-connect cycle; ",[154,277,278],{},"Reset errors and reconnect","\ntries again on purpose.",[134,281,283],{"id":282},"number-changes","Number changes",[177,285,286,287,290],{},"After swapping a SIM or porting a number, use ",[154,288,289],{},"Clear number"," on the port: the old number leaves\nthe sale and the new one is read and listed.",{"title":292,"searchDepth":293,"depth":293,"links":294},"",2,[295,296,297,298],{"id":136,"depth":293,"text":137},{"id":186,"depth":293,"text":187},{"id":196,"depth":293,"text":197},{"id":282,"depth":293,"text":283},"How a SIM becomes a number on sale, auto-connect, rent, and what the server's answers mean.","md",null,{},{"icon":29},{"title":26,"description":299},"KqcRW-dVUGECm5GoOkOzx_pDp-uR5e3jfijv48nG5BU",[307,309],{"title":21,"path":22,"description":308},"Adding ports, reading the port list and what each status means.",{"title":31,"path":32,"description":310},"The SMS inbox of a port, USSD requests, and teaching the gateway an operator's own-number and balance codes.",1794978314518]