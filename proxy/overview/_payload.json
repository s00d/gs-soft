vice","\u002Fheadless\u002Fservice","2.headless\u002F3.service","i-lucide-server-cog",{"title":78,"path":79,"stem":80,"icon":81},"Network ports","\u002Fheadless\u002Fnetwork-ports","2.headless\u002F4.network-ports","i-lucide-network",{"title":83,"icon":84,"path":85,"stem":86,"children":87,"page":55},"Gateway Phone","i-lucide-smartphone","\u002Fphone","3.phone",[88,92],{"title":89,"path":90,"stem":91,"icon":84},"Overview","\u002Fphone\u002Foverview","3.phone\u002F1.overview",{"title":93,"path":94,"stem":95,"icon":96},"Install and set up","\u002Fphone\u002Fsetup","3.phone\u002F2.setup","i-lucide-list-checks",{"title":98,"icon":81,"path":99,"stem":100,"children":101,"page":55},"Gateway Proxy","\u002Fproxy","4.proxy",[102,105],{"title":89,"path":103,"stem":104,"icon":81},"\u002Fproxy\u002Foverview","4.proxy\u002F1.overview",{"title":93,"path":106,"stem":107,"icon":96},"\u002Fproxy\u002Fsetup","4.proxy\u002F2.setup",{"title":109,"icon":110,"path":111,"stem":112,"children":113,"page":55},"Hardware","i-lucide-cpu","\u002Fhardware","5.hardware",[114,118],{"title":115,"path":116,"stem":117,"icon":110},"Supported modems","\u002Fhardware\u002Fmodems","5.hardware\u002F1.modems",{"title":119,"path":120,"stem":121,"icon":122},"Drivers","\u002Fhardware\u002Fdrivers","5.hardware\u002F2.drivers","i-lucide-usb",{"title":124,"path":125,"stem":126,"icon":127},"FAQ","\u002Ffaq","6.faq","i-lucide-circle-help",{"id":129,"title":98,"body":130,"description":263,"extension":264,"links":265,"meta":266,"navigation":267,"path":103,"seo":268,"stem":104,"__hash__":269},"docs_en\u002F4.proxy\u002F1.overview.md",{"type":131,"value":132,"toc":258},"minimark",[133,142,145,161,223,228,245,251],[134,135,136,137,141],"p",{},"Gateway Proxy runs on an Android phone (8.0 or newer) and turns it into a SOCKS5 \u002F HTTP proxy.\n",[138,139,140],"strong",{},"All proxy traffic and its DNS leave only through the SIM's mobile data",", even while the phone is on\nWi-Fi. Without mobile data connections are refused; there is never a fallback to Wi-Fi.",[134,143,144],{},"The proxy is used in two ways at once:",[146,147,148,155],"ul",{},[149,150,151,154],"li",{},[138,152,153],{},"On your Wi-Fi:"," devices on the same network connect to the phone's address and port 1080.",[149,156,157,160],{},[138,158,159],{},"On the marketplace:"," buyers get their own ports through the relay server. The phone needs no\npublic IP and no port forwarding, and it works behind carrier NAT.",[162,163,164,177],"table",{},[165,166,167],"thead",{},[168,169,170,173,175],"tr",{},[171,172],"th",{},[171,174,83],{},[171,176,98],{},[178,179,180,192,203,213],"tbody",{},[168,181,182,186,189],{},[183,184,185],"td",{},"Sells",[183,187,188],{},"The phone's SIM cards (SMS, numbers)",[183,190,191],{},"The SIM's mobile internet",[168,193,194,197,200],{},[183,195,196],{},"Account",[183,198,199],{},"Seller email and password",[183,201,202],{},"Seller API token",[168,204,205,208,211],{},[183,206,207],{},"Runs on",[183,209,210],{},"Android 8.0+",[183,212,210],{},[168,214,215,217,220],{},[183,216,46],{},[183,218,219],{},"Automatic",[183,221,222],{},"Automatic, from the same release",[224,225,227],"h2",{"id":226},"how-it-works","How it works",[146,229,230,233,239,242],{},[149,231,232],{},"A background service keeps the proxy and the link to the relay running with the screen off; a\nwatchdog restarts it if Android stops it.",[149,234,235,238],{},[138,236,237],{},"Stop"," in the notification turns the proxy off until you open the app again.",[149,240,241],{},"The main screen shows the address, login and password, the SIM's external IP, connections and\ntraffic up \u002F down for the Wi-Fi port and for buyers, and warnings with a fix (no mobile data, Data\nSaver, battery optimization, no Wi-Fi).",[149,243,244],{},"Traffic quota and speed limits are set on the phone only.",[246,247,248],"warning",{},[134,249,250],{},"In 0.9.0 the relay address built into the app is a placeholder, so selling on the marketplace does\nnot work yet. The Wi-Fi proxy works. The address comes with the next release.",[134,252,253,254,257],{},"Next: ",[255,256,93],"a",{"href":106},".",{"title":259,"searchDepth":260,"depth":260,"links":261},"",2,[262],{"id":226,"depth":260,"text":227},"An Android app that turns a phone into a SOCKS5 \u002F HTTP proxy over its SIM and sells it on the marketplace.","md",null,{},{"title":89,"icon":81},{"title":98,"description":263},"8d9Ox8_qjaRYCaixXCdcxHXjWMqSCYxRaZuI0kjQQ2s",[265,271],{"title":93,"path":106,"description":272},"Installing the APK, keeping it alive, connecting clients, selling, limits and multiple SIMs.",1794978317883]