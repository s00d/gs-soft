s",[134,279,280,281,284,285,274],{},"Install ",[138,282,283],{},"CH34xVCPDriver.pkg"," from the archive, then allow the system extension in ",[190,286,287],{},"System Settings →\nPrivacy & Security",[238,289,226],{"id":290},"linux",[134,292,293,294,297,298,301],{},"Plug the board in and check ",[138,295,296],{},"ls \u002Fdev\u002FttyUSB*",". Add your user to ",[138,299,300],{},"dialout"," for access:",[246,303,307],{"className":304,"code":305,"language":306,"meta":251,"style":251},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo usermod -aG dialout \"$USER\"\n","bash",[138,308,309],{"__ignoreMap":251},[255,310,311,315,319,322,325,329,333],{"class":257,"line":258},[255,312,314],{"class":313},"sBMFI","sudo",[255,316,318],{"class":317},"sfazB"," usermod",[255,320,321],{"class":317}," -aG",[255,323,324],{"class":317}," dialout",[255,326,328],{"class":327},"sMK4o"," \"",[255,330,332],{"class":331},"sTEyZ","$USER",[255,334,335],{"class":327},"\"\n",[238,337,339],{"id":338},"other-usb-serial-chips","Other USB-serial chips",[134,341,342,343,346,347,350,351,354],{},"Find the chip by its USB ID: ",[190,344,345],{},"Device Manager → the device → Details → Hardware Ids"," on Windows,\n",[138,348,349],{},"lsusb"," on Linux, ",[190,352,353],{},"System Information → USB"," on macOS.",[143,356,357,373],{},[146,358,359],{},[149,360,361,364,367,369,371],{},[152,362,363],{},"USB ID",[152,365,366],{},"Chip",[152,368,241],{},[152,370,204],{},[152,372,226],{},[162,374,375,409,436,466],{},[149,376,377,386,389,397,402],{},[167,378,379,382,383],{},[138,380,381],{},"1a86:55d2"," – ",[138,384,385],{},"55ef",[167,387,388],{},"WCH CH342 \u002F CH343 \u002F CH9102 \u002F CH9143",[167,390,391,392],{},"Windows 10+ works without a driver; older: ",[176,393,396],{"href":394,"rel":395},"https:\u002F\u002Fwww.wch-ic.com\u002Fdownloads\u002FCH343SER_ZIP.html",[180],"CH343SER.ZIP",[167,398,399],{},[176,400,221],{"href":219,"rel":401},[180],[167,403,