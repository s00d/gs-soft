hash__":241},"docs_de\u002Fde\u002F1.guide\u002F5.sms-ussd.md",{"type":131,"value":132,"toc":227},"minimark",[133,138,146,150,166,170,185,201,208,212,218],[134,135,137],"h2",{"id":136},"sms-posteingang","SMS-Posteingang",[139,140,141,142,145],"p",{},"Der ",[143,144,137],"strong",{}," eines Ports listet, was seine SIM empfangen hat. Nachrichten für Käufer werden\nautomatisch an den Server weitergeleitet; der Posteingang dient zur Prüfung einer SIM von Hand.",[134,147,149],{"id":148},"ussd","USSD",[139,151,152,153,157,158,161,162,165],{},"Senden Sie eine beliebige USSD-Anfrage (",[154,155,156],"code",{},"*100#",", ",[154,159,160],{},"*111*0887#",", …) aus dem Detailfenster eines Ports\noder an viele Ports gleichzeitig über ",[143,163,164],{},"Mehr → Massen-USSD",". Die Antwort erscheint im Log des Ports.",[134,167,169],{"id":168},"codes-für-eigene-nummer-und-guthaben","Codes für eigene Nummer und Guthaben",[139,171,172,173,176,177,180,181,184],{},"Das Gateway kennt die Codes vieler Betreiber. Für andere legen Sie sie einmal unter ",[143,174,175],{},"Einstellungen →\nUSSD-Befehle"," fest, pro Betreiber (",[154,178,179],{},"MCC:MNC",", zum Beispiel ",[154,182,183],{},"250:11","):",[186,187,188,195],"ul",{},[189,190,191,194],"li",{},[143,192,193],{},"Eigene Nummer"," — die Anfrage, deren Antwort die Nummer der SIM enthält; wird genutzt, wenn die\nSIM sie nicht selbst speichert.",[189,196,197,200],{},[143,198,199],{},"Guthaben"," — wird in den Portdetails angezeigt.",[139,202,203,204,207],{},"Wenn Sie einen Eintrag entfernen, gilt wieder der integrierte Code. Störzeichen in Antworten (Präfixe,\nTrennzeichen) werden automatisch bereinigt; zusätzliche Muster gehören in ",[143,205,206],{},"Einstellungen → Nummern &\nIMSI",".",[134,209,211],{"id":210},"debug-werkzeuge","Debug-Werkzeuge",[139,213,214,217],{},[143,215,216],{},"Debug"," öffnet Low-Level-Werkzeuge für einen Port, der nicht in Betrieb ist: eine AT-Konsole mit\nVorlagen, Lua-Skripte, Modem-Tests, einen SMS-Editor und den Laufzeitzustand des Ports. Nutzen Sie sie\nnur zur Diagnose: Ein Port im Debug-Bereich verkauft nicht.",[139,219,220],{},[221,222],"img",{"alt":223,"className":224,"src":226},"AT-Konsole",[225],"prose-shot","\u002Fscreenshots\u002Fde\u002F03_at_console.png",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234],{"id":136,"depth":229,"text":137},{"id":148,"depth":229,"text":149},{"id":168,"depth":229,"text":169},{"id":210,"depth":229,"text":211},"Der SMS-Posteingang eines Ports, USSD-Anfragen und wie Sie dem Gateway die Codes für eigene Nummer und Guthaben eines Betreibers beibringen.","md",null,{},{"icon":34},{"title":31,"description":235},"CJvm05KtJSe8urgeam0n6tIQQUvh2w9psPa0c38tPa8",[243,245],{"title":26,"path":27,"description":244},"Wie aus einer SIM eine Nummer im Verkauf wird, automatisches Verbinden, Miete und was die Antworten des Servers bedeuten.",{"title":36,"path":37,"description":246},"Die Einstellungen, die im Alltag zählen, gruppiert wie in der App.",1794978320149]