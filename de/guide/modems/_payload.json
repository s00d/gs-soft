less\u002F1.serve","i-lucide-terminal",{"title":68,"path":69,"stem":70,"icon":71},"Web UI","\u002Fde\u002Fheadless\u002Fweb-ui","de\u002F2.headless\u002F2.web-ui","i-lucide-globe",{"title":73,"path":74,"stem":75,"icon":76},"Als Dienst betreiben","\u002Fde\u002Fheadless\u002Fservice","de\u002F2.headless\u002F3.service","i-lucide-server-cog",{"title":78,"path":79,"stem":80,"icon":81},"Netzwerkports","\u002Fde\u002Fheadless\u002Fnetwork-ports","de\u002F2.headless\u002F4.network-ports","i-lucide-network",{"title":83,"icon":84,"path":85,"stem":86,"children":87,"page":55},"Gateway Phone","i-lucide-smartphone","\u002Fde\u002Fphone","de\u002F3.phone",[88,92],{"title":89,"path":90,"stem":91,"icon":84},"Überblick","\u002Fde\u002Fphone\u002Foverview","de\u002F3.phone\u002F1.overview",{"title":93,"path":94,"stem":95,"icon":96},"Installation und Einrichtung","\u002Fde\u002Fphone\u002Fsetup","de\u002F3.phone\u002F2.setup","i-lucide-list-checks",{"title":98,"icon":81,"path":99,"stem":100,"children":101,"page":55},"Gateway Proxy","\u002Fde\u002Fproxy","de\u002F4.proxy",[102,105],{"title":89,"path":103,"stem":104,"icon":81},"\u002Fde\u002Fproxy\u002Foverview","de\u002F4.proxy\u002F1.overview",{"title":93,"path":106,"stem":107,"icon":96},"\u002Fde\u002Fproxy\u002Fsetup","de\u002F4.proxy\u002F2.setup",{"title":109,"icon":110,"path":111,"stem":112,"children":113,"page":55},"Hardware","i-lucide-cpu","\u002Fde\u002Fhardware","de\u002F5.hardware",[114,118],{"title":115,"path":116,"stem":117,"icon":110},"Unterstützte Modems","\u002Fde\u002Fhardware\u002Fmodems","de\u002F5.hardware\u002F1.modems",{"title":119,"path":120,"stem":121,"icon":122},"Treiber","\u002Fde\u002Fhardware\u002Fdrivers","de\u002F5.hardware\u002F2.drivers","i-lucide-usb",{"title":124,"path":125,"stem":126,"icon":127},"FAQ","\u002Fde\u002Ffaq","de\u002F6.faq","i-lucide-circle-help",{"id":129,"title":21,"body":130,"description":344,"extension":345,"links":346,"meta":347,"navigation":348,"path":22,"seo":349,"stem":23,"__hash__":350},"docs_de\u002Fde\u002F1.guide\u002F3.modems.md",{"type":131,"value":132,"toc":337},"minimark",[133,143,148,173,180,198,202,205,285,289,292,330],[134,135,136],"p",{},[137,138],"img",{"alt":139,"className":140,"src":142},"Portliste mit den Details eines Modems",[141],"prose-shot","\u002Fscreenshots\u002Fde\u002F02_modem_detail.png",[144,145,147],"h2",{"id":146},"ports-hinzufügen","Ports hinzufügen",[149,150,151,155,162],"ol",{},[152,153,154],"li",{},"Stecken Sie die Modems an.",[152,156,157,161],{},[158,159,160],"strong",{},"Portliste → Hinzufügen"," zeigt die seriellen Ports des Computers, die noch nicht belegt sind.\nSystemports (Bluetooth, Debug-Konsolen) sind ausgeblendet.",[152,163,164,165,168,169,172],{},"Haken Sie die Ports an und klicken Sie auf ",[158,166,167],{},"Hinzufügen"," oder ",[158,170,171],{},"Alle Ports hinzufügen",".",[134,174,175,176,179],{},"Hinzugefügte Ports werden gespeichert: Das Gateway verbindet sie bei jedem Start und immer dann, wenn\nein Modem wieder in denselben USB-Port gesteckt wird. ",[158,177,178],{},"Aus dem Gateway entfernen"," vergisst einen Port.",[134,181,182,183,187,188,191,192,194,195,172],{},"Netzwerk-Seriell-Brücken (",[184,185,186],"code",{},"tcp:\u002F\u002Fhost:port",") und Bluetooth-LE-UART-Adapter (",[184,189,190],{},"ble:\u002F\u002F…",") werden auf der\nSeite ",[158,193,109],{}," hinzugefügt und erscheinen dann in derselben Liste. Siehe\n",[196,197,78],"a",{"href":79},[144,199,201],{"id":200},"die-portliste","Die Portliste",[134,203,204],{},"Jede Zeile zeigt Port, Betreiber, Nummer, Signal und Status. Der Filter über der Liste grenzt sie auf\nverfügbare, im Gateway laufende, Online- oder Problem-Ports ein. Wählen Sie eine Zeile, um das\nDetailfenster zu öffnen: Name und Nummer des Ports, SIM-Daten (IMSI, ICCID, IMEI, Betreiber, Land),\nErtrag und die Dienste, die die Nummer genutzt oder gesperrt haben.",[206,207,208,221],"table",{},[209,210,211],"thead",{},[212,213,214,218],"tr",{},[215,216,217],"th",{},"Status",[215,219,220],{},"Bedeutung",[222,223,224,235,245,255,265,275],"tbody",{},[212,225,226,232],{},[227,228,229],"td",{},[158,230,231],{},"Online",[227,233,234],{},"Die Nummer ist im Verkauf.",[212,236,237,242],{},[227,238,239],{},[158,240,241],{},"In Warteschlange",[227,243,244],{},"Die Nummer wurde an den Server gesendet und wartet auf den Verkaufsstart.",[212,246,247,252],{},[227,248,249],{},[158,250,251],{},"Verbinde",[227,253,254],{},"Das Gateway kommuniziert gerade mit dem Modem oder dem Server.",[212,256,257,262],{},[227,258,259],{},[158,260,261],{},"Offline",[227,263,264],{},"Das Modem funktioniert, aber die Nummer ist nicht im Verkauf (automatisches Verbinden aus, nicht angemeldet).",[212,266,267,272],{},[227,268,269],{},[158,270,271],{},"Probleme",[227,273,274],{},"Etwas braucht Aufmerksamkeit: Das Banner im Detailfenster sagt, was.",[212,276,277,282],{},[227,278,279],{},[158,280,281],{},"Getrennt",[227,283,284],{},"Das Modem ist nicht angesteckt oder antwortet nicht.",[144,286,288],{"id":287},"port-aktionen","Port-Aktionen",[134,290,291],{},"Klicken Sie mit der rechten Maustaste auf einen Port (oder nutzen Sie die Schaltflächen im\nDetailfenster):",[293,294,295,301,307,313,319,325],"ul",{},[152,296,297,300],{},[158,298,299],{},"SMS-Posteingang"," — Nachrichten, die die SIM empfangen hat.",[152,302,303,306],{},[158,304,305],{},"LED-Benachrichtigung"," — lässt das Modem blinken, um es im Rack zu finden.",[152,308,309,312],{},[158,310,311],{},"Fehler zurücksetzen und neu verbinden"," — löscht die Fehler und listet die Nummer erneut; stellt\naußerdem einen Port mit bekannter Nummer ohne globales automatisches Verbinden in den Verkauf.",[152,314,315,318],{},[158,316,317],{},"Nummer löschen"," — nimmt die Nummer aus dem Verkauf und vergisst sie (neue SIM, geänderte Nummer).",[152,320,321,324],{},[158,322,323],{},"Fehler anzeigen"," — der vollständige Text des letzten Fehlers.",[152,326,327,329],{},[158,328,178],{}," — den Port vergessen.",[134,331,332,333,336],{},"Die Werkzeugleiste über der Liste sendet USSD an viele Ports gleichzeitig (",[158,334,335],{},"Mehr → Massen-USSD",") und\nprüft den Zustand jedes Modems.",{"title":338,"searchDepth":339,"depth":339,"links":340},"",2,[341,342,343],{"id":146,"depth":339,"text":147},{"id":200,"depth":339,"text":201},{"id":287,"depth":339,"text":288},"Ports hinzufügen, die Portliste lesen und was jeder Status bedeutet.","md",null,{},{"icon":24},{"title":21,"description":344},"BM89sH1JOrJ0VFUqf-Ir7uxRBxGARqKvV2xSm5FxR3Y",[352,354],{"title":16,"path":17,"description":353},"Installer für Windows, macOS und Linux, welche Datei Sie wählen und wo das Gateway seine Daten ablegt.",{"title":26,"path":27,"description":355},"Wie aus einer SIM eine Nummer im Verkauf wird, automatisches Verbinden, Miete und was die Antworten des Servers bedeuten.",1794978320094]