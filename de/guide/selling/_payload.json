adless\u002F1.serve","i-lucide-terminal",{"title":68,"path":69,"stem":70,"icon":71},"Web UI","\u002Fde\u002Fheadless\u002Fweb-ui","de\u002F2.headless\u002F2.web-ui","i-lucide-globe",{"title":73,"path":74,"stem":75,"icon":76},"Als Dienst betreiben","\u002Fde\u002Fheadless\u002Fservice","de\u002F2.headless\u002F3.service","i-lucide-server-cog",{"title":78,"path":79,"stem":80,"icon":81},"Netzwerkports","\u002Fde\u002Fheadless\u002Fnetwork-ports","de\u002F2.headless\u002F4.network-ports","i-lucide-network",{"title":83,"icon":84,"path":85,"stem":86,"children":87,"page":55},"Gateway Phone","i-lucide-smartphone","\u002Fde\u002Fphone","de\u002F3.phone",[88,92],{"title":89,"path":90,"stem":91,"icon":84},"Überblick","\u002Fde\u002Fphone\u002Foverview","de\u002F3.phone\u002F1.overview",{"title":93,"path":94,"stem":95,"icon":96},"Installation und Einrichtung","\u002Fde\u002Fphone\u002Fsetup","de\u002F3.phone\u002F2.setup","i-lucide-list-checks",{"title":98,"icon":81,"path":99,"stem":100,"children":101,"page":55},"Gateway Proxy","\u002Fde\u002Fproxy","de\u002F4.proxy",[102,105],{"title":89,"path":103,"stem":104,"icon":81},"\u002Fde\u002Fproxy\u002Foverview","de\u002F4.proxy\u002F1.overview",{"title":93,"path":106,"stem":107,"icon":96},"\u002Fde\u002Fproxy\u002Fsetup","de\u002F4.proxy\u002F2.setup",{"title":109,"icon":110,"path":111,"stem":112,"children":113,"page":55},"Hardware","i-lucide-cpu","\u002Fde\u002Fhardware","de\u002F5.hardware",[114,118],{"title":115,"path":116,"stem":117,"icon":110},"Unterstützte Modems","\u002Fde\u002Fhardware\u002Fmodems","de\u002F5.hardware\u002F1.modems",{"title":119,"path":120,"stem":121,"icon":122},"Treiber","\u002Fde\u002Fhardware\u002Fdrivers","de\u002F5.hardware\u002F2.drivers","i-lucide-usb",{"title":124,"path":125,"stem":126,"icon":127},"FAQ","\u002Fde\u002Ffaq","de\u002F6.faq","i-lucide-circle-help",{"id":129,"title":26,"body":130,"description":298,"extension":299,"links":300,"meta":301,"navigation":302,"path":27,"seo":303,"stem":28,"__hash__":304},"docs_de\u002Fde\u002F1.guide\u002F4.selling.md",{"type":131,"value":132,"toc":290},"minimark",[133,138,173,184,188,194,198,273,279,283],[134,135,137],"h2",{"id":136},"von-der-sim-zum-verkauf","Von der SIM zum Verkauf",[139,140,141,150,170],"ol",{},[142,143,144,145,149],"li",{},"Das Gateway liest die SIM (IMSI, ICCID) und ermittelt die Nummer: von der SIM selbst, aus ihrem\nTelefonbuch oder per USSD-Anfrage des Betreibers (",[146,147,148],"code",{},"*…#","). Die Nummer lässt sich jederzeit im\nDetailfenster eintippen.",[142,151,152,153,157,158,161,162,165,166,169],{},"Ist ",[154,155,156],"strong",{},"Automatisch verbinden"," an (",[154,159,160],{},"Einstellungen → Allgemein","), wird die Nummer an den Server\ngesendet; der Port geht auf ",[154,163,164],{},"In Warteschlange"," und dann auf ",[154,167,168],{},"Online",", sobald der Server sie\nverkauft.",[142,171,172],{},"SMS der Käufer kommen am Modem an; das Gateway leitet sie sofort an den Server weiter. SMS, die\neintreffen, während der Server nicht erreichbar ist, werden aufbewahrt und später gesendet.",[174,175,176],"tip",{},[177,178,179,180,183],"p",{},"Lassen Sie das automatische Verbinden aus, um neue SIMs zuerst zu prüfen; stellen Sie dann einzelne\nPorts mit ",[154,181,182],{},"Fehler zurücksetzen und neu verbinden"," in den Verkauf.",[134,185,187],{"id":186},"miete","Miete",[177,189,190,191,193],{},"Der Schalter ",[154,192,187],{}," im Detailfenster bietet die Nummer zusätzlich zu einzelnen Aktivierungen auch\nzur Langzeitmiete an. Die Auswahl bleibt pro Port über Neustarts hinweg erhalten.",[134,195,197],{"id":196},"antworten-des-servers","Antworten des Servers",[199,200,201,217],"table",{},[202,203,204],"thead",{},[205,206,207,211,214],"tr",{},[208,209,210],"th",{},"Angezeigt",[208,212,213],{},"Was passiert ist",[208,215,216],{},"Was zu tun ist",[218,219,220,234,247,260],"tbody",{},[205,221,222,228,231],{},[223,224,225],"td",{},[154,226,227],{},"Nummer wiederverwendet",[223,229,230],{},"Der Server lehnt Miete für eine Nummer ab, die schon für Aktivierungen genutzt wurde.",[223,232,233],{},"Schalten Sie die Miete für diesen Port aus.",[205,235,236,241,244],{},[223,237,238],{},[154,239,240],{},"Nummer gesperrt",[223,242,243],{},"Die Nummer hat zu viele fehlgeschlagene Aktivierungen gesammelt.",[223,245,246],{},"Der Server hebt Sperren beim nächtlichen Reset auf.",[205,248,249,254,257],{},[223,250,251],{},[154,252,253],{},"Dienst gesperrt",[223,255,256],{},"Ein Dienst (zum Beispiel ein Messenger) hat die Nummer blockiert.",[223,258,259],{},"Nichts; die Nummer wird weiter an andere Dienste verkauft.",[205,261,262,267,270],{},[223,263,264],{},[154,265,266],{},"Port inaktiv",[223,268,269],{},"Der Server hat die Listung abgeschaltet.",[223,271,272],{},"Prüfen Sie Nummer und Konto; dann neu verbinden.",[177,274,275,276,278],{},"Einen Port, den der Server abgelehnt hat, sendet der Zyklus des automatischen Verbindens nicht erneut;\n",[154,277,182],{}," versucht es gezielt noch einmal.",[134,280,282],{"id":281},"nummernwechsel","Nummernwechsel",[177,284,285,286,289],{},"Nach einem SIM-Tausch oder einer Rufnummernmitnahme nutzen Sie ",[154,287,288],{},"Nummer löschen"," am Port: Die alte\nNummer verlässt den Verkauf, die neue wird gelesen und gelistet.",{"title":291,"searchDepth":292,"depth":292,"links":293},"",2,[294,295,296,297],{"id":136,"depth":292,"text":137},{"id":186,"depth":292,"text":187},{"id":196,"depth":292,"text":197},{"id":281,"depth":292,"text":282},"Wie aus einer SIM eine Nummer im Verkauf wird, automatisches Verbinden, Miete und was die Antworten des Servers bedeuten.","md",null,{},{"icon":29},{"title":26,"description":298},"7z35wkNKQVVSq2fArOEzaqgvm3c2Dyue_i2o4cNH6Y0",[306,308],{"title":21,"path":22,"description":307},"Ports hinzufügen, die Portliste lesen und was jeder Status bedeutet.",{"title":31,"path":32,"description":309},"Der SMS-Posteingang eines Ports, USSD-Anfragen und wie Sie dem Gateway die Codes für eigene Nummer und Guthaben eines Betreibers beibringen.",1794978320117]