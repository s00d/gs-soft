sh__":231},"docs_de\u002Fde\u002F1.guide\u002F8.updates.md",{"type":131,"value":132,"toc":220},"minimark",[133,145,201,204,209],[134,135,136,137,144],"p",{},"Neue Versionen erscheinen auf der ",[138,139,143],"a",{"href":140,"rel":141},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fgs-soft\u002Freleases",[142],"nofollow","Release-Seite","; jede\nEdition prüft sie selbstständig.",[146,147,148,161],"table",{},[149,150,151],"thead",{},[152,153,154,158],"tr",{},[155,156,157],"th",{},"Edition",[155,159,160],{},"Wie sie sich aktualisiert",[162,163,164,173,186,193],"tbody",{},[152,165,166,170],{},[167,168,169],"td",{},"Desktop-App (Windows, macOS, Linux x86_64 \u002F ARM64 \u002F ARMv7)",[167,171,172],{},"Prüft alle 10 Minuten, lädt das Update im Hintergrund herunter, installiert es und sagt Ihnen dann Bescheid; die neue Version startet beim nächsten Neustart (Tray → Neustart, oder beenden und neu starten).",[152,174,175,183],{},[167,176,177,178,182],{},"Headless (",[179,180,181],"code",{},"--serve",")",[167,184,185],{},"Derselbe Updater; unter Windows läuft der Installer im passiven Modus. Starten Sie den Dienst neu, um zu wechseln.",[152,187,188,190],{},[167,189,83],{},[167,191,192],{},"Das Telefon prüft das Release beim Start und regelmäßig und installiert die neue APK (Android fragt nach einer Bestätigung, außer die App ist Geräteinhaber).",[152,194,195,198],{},[167,196,197],{},"Android (Desktop-Oberfläche)",[167,199,200],{},"Prüft das Release beim Start und alle 10 Minuten, lädt die neue APK herunter, verifiziert sie und öffnet dann den Android-Installer zur Bestätigung. Beim ersten Mal fragt Android, ob Gateway Soft Apps installieren darf.",[134,202,203],{},"Jedes Update ist signiert; die App lehnt eine Datei ab, die nicht mit dem Gateway-Soft-Schlüssel\nsigniert wurde.",[205,206,208],"h2",{"id":207},"von-hand-aktualisieren","Von Hand aktualisieren",[134,210,211,212,215,216,219],{},"Laden Sie den Installer der neuen Version herunter und führen Sie ihn über der alten aus:\nEinstellungen, Sitzung und hinzugefügte Ports bleiben erhalten. Unter Linux installieren Sie die neue\n",[179,213,214],{},".deb"," \u002F ",[179,217,218],{},".rpm"," genauso wie beim ersten Mal.",{"title":221,"searchDepth":222,"depth":222,"links":223},"",2,[224],{"id":207,"depth":222,"text":208},"Wie sich jede Edition selbst aktualisiert und wie Sie von Hand aktualisieren.","md",null,{},{"icon":49},{"title":46,"description":225},"-Nb32Pg5evTrUlnzWwsies9sAOhwrOFN9kEemJGw0I4",[233,235],{"title":41,"path":42,"description":234},"Ertrag, Auszahlungen und die Verkaufsstatistik Ihres Kontos.",{"title":51,"path":52,"description":236},"Die üblichen Probleme und wo Sie zuerst nachsehen.",1794978320245]