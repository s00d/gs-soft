\u002F6.faq.md",{"type":131,"value":132,"toc":238},"minimark",[133,138,147,151,154,158,187,191,199,203,206,210,220,224],[134,135,137],"h2",{"id":136},"was-ist-der-unterschied-zwischen-desktop-app-und-headless","Was ist der Unterschied zwischen Desktop-App und Headless?",[139,140,141,142,146],"p",{},"Nur das Fenster. Headless ist dasselbe Programm, gestartet mit ",[143,144,145],"code",{},"--serve",": kein Fenster und kein Tray,\ndie Oberfläche im Browser. Beide verkaufen Nummern, beide aktualisieren sich selbst.",[134,148,150],{"id":149},"brauche-ich-für-jeden-computer-oder-jedes-telefon-ein-eigenes-konto","Brauche ich für jeden Computer oder jedes Telefon ein eigenes Konto?",[139,152,153],{},"Nein. Melden Sie sich überall mit demselben Verkäuferkonto an; jedes Gateway erscheint als eigenes\nGerät und listet seine eigenen SIMs.",[134,155,157],{"id":156},"welche-datei-lade-ich-herunter","Welche Datei lade ich herunter?",[139,159,160,161,166,167,170,171,174,175,178,179,182,183,186],{},"Die ",[162,163,165],"a",{"href":164},"\u002Fde\u002Fdownloads","Download-Seite"," zeigt Ihr System zuerst. Im Zweifel: Windows ",[143,168,169],{},"x64-setup.exe",",\nmacOS ",[143,172,173],{},"universal.dmg",", Linux ",[143,176,177],{},"amd64.AppImage"," oder die ",[143,180,181],{},".deb",", ein Telefon\n",[143,184,185],{},"Gateway.Phone_…_universal.apk",".",[134,188,190],{"id":189},"wie-viele-modems-kann-ein-gateway-betreiben","Wie viele Modems kann ein Gateway betreiben?",[139,192,193,194,198],{},"Hunderte Ports; die Grenze setzen eher USB-Stromversorgung und Bandbreite als die Software.\n",[195,196,197],"strong",{},"Einstellungen → Verbindungen"," begrenzt auf schwacher Hardware, wie viele Ports gleichzeitig ihre\nNummern listen.",[134,200,202],{"id":201},"funktioniert-es-ohne-internet","Funktioniert es ohne Internet?",[139,204,205],{},"Die Modems arbeiten weiter und eingehende SMS werden aufbewahrt; die Nummern gehen wieder in den\nVerkauf und die SMS werden zugestellt, sobald der Server wieder erreichbar ist.",[134,207,209],{"id":208},"ist-der-quellcode-öffentlich","Ist der Quellcode öffentlich?",[139,211,212,213,219],{},"Nein. Gateway Soft wird als signierte Binärdateien verteilt; diese Website und die\n",[162,214,218],{"href":215,"rel":216},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fgs-soft\u002Freleases",[217],"nofollow","Releases"," sind öffentlich.",[134,221,223],{"id":222},"wo-melde-ich-ein-problem","Wo melde ich ein Problem?",[139,225,226,227,230,231,234,235,237],{},"Sammeln Sie ",[143,228,229],{},"logs\u002Fmain.log"," mit der Protokollstufe ",[143,232,233],{},"debug","\n(",[162,236,51],{"href":52},") und senden Sie es mit der App-Version an den Support.",{"title":239,"searchDepth":240,"depth":240,"links":241},"",2,[242,243,244,245,246,247,248],{"id":136,"depth":240,"text":137},{"id":149,"depth":240,"text":150},{"id":156,"depth":240,"text":157},{"id":189,"depth":240,"text":190},{"id":201,"depth":240,"text":202},{"id":208,"depth":240,"text":209},{"id":222,"depth":240,"text":223},"Kurze Antworten auf die häufigsten Fragen.","md",null,{},{"icon":127},{"title":124,"description":249},"q9Ict_1Isvll4JhiUNfq3v2FOlBaJwooq6tSkkf2N-0",[251,251],1794978319581]