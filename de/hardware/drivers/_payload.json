shell shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","pnputil \u002Fadd-driver \"CH341SER\\WIN 1X\\CH341SER.INF\" \u002Finstall\n","powershell","",[138,251,252],{"__ignoreMap":249},[253,254,257],"span",{"class":255,"line":256},"line",1,[253,258,247],{},[134,260,261,264,265,268,269,272],{},[189,262,263],{},"Geräte-Manager → Anschlüsse (COM & LPT)"," zeigt dann ",[189,266,267],{},"USB-SERIAL CH340 (COMn)",", und der Port\nerscheint unter ",[189,270,271],{},"Portliste → Hinzufügen",".",[236,274,203],{"id":275},"macos",[134,277,278,279,282,283,272],{},"Installieren Sie ",[138,280,281],{},"CH34xVCPDriver.pkg"," aus dem Archiv und erlauben Sie dann die Systemerweiterung unter\n",[189,284,285],{},"Systemeinstellungen → Datenschutz & Sicherheit",[236,287,225],{"id":288},"linux",[134,290,291,292,295,296,299],{},"Stecken Sie das Board an und prüfen Sie ",[138,293,294],{},"ls \u002Fdev\u002FttyUSB*",". Fügen Sie Ihren Benutzer für den Zugriff zu\n",[138,297,298],{},"dialout"," hinzu:",[244,301,305],{"className":302,"code":303,"language":304,"meta":249,"style":249},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo usermod -aG dialout \"$USER\"\n","bash",[138,306,307],{"__ignoreMap":249},[253,308,309,313,317,320,323,327,331],{"class":255,"line":256},[253,310,312],{"class":311},"sBMFI","sudo",[253,314,316],{"class":315},"sfazB"," usermod",[253,318,319],{"class":315}," -aG",[253,321,322],{"class":315}," dialout",[253,324,326],{"class":325},"sMK4o"," \"",[253,328,330],{"class":329},"sTEyZ","$USER",[253,332,333],{"class":325},"\"\n",[236,335,337],{"id":336},"weitere-usb-seriell-chips","Weitere USB-Seriell-Chips",[134,339,340,341,344,345,348,349,272],{},"Den Chip erkennen Sie an der USB-ID: unter Windows ",[189,342,343],{},"Geräte-Manager → Gerät → Details → Hardware-IDs",",\nunter Linux ",[138,346,347],{},"lsusb",", unter macOS ",[189,350,351],{},"Systeminformationen → USB",[143,353,354,370],{}