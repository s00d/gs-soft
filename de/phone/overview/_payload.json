hash__":242},"docs_de\u002Fde\u002F3.phone\u002F1.overview.md",{"type":131,"value":132,"toc":231},"minimark",[133,137,201,206,224],[134,135,136],"p",{},"Gateway Phone läuft auf einem Android-Telefon (8.0 oder neuer) und arbeitet wie das Desktop-Gateway,\nnur ohne Computer: Es meldet sich bei Ihrem Verkäuferkonto an, stellt die SIM-Karten des Telefons in\nden Verkauf, empfängt die SMS und leitet sie an den Server weiter.",[138,139,140,154],"table",{},[141,142,143],"thead",{},[144,145,146,149,152],"tr",{},[147,148],"th",{},[147,150,151],{},"Desktop-Gateway",[147,153,83],{},[155,156,157,169,180,191],"tbody",{},[144,158,159,163,166],{},[160,161,162],"td",{},"SIM-Karten",[160,164,165],{},"USB-Modems",[160,167,168],{},"Die eigenen SIM-Slots des Telefons (auch Dual-SIM)",[144,170,171,174,177],{},[160,172,173],{},"Läuft auf",[160,175,176],{},"Windows, macOS, Linux",[160,178,179],{},"Android 8.0+",[144,181,182,185,188],{},[160,183,184],{},"Konto",[160,186,187],{},"Verkäuferkonto",[160,189,190],{},"Dasselbe Verkäuferkonto",[144,192,193,195,198],{},[160,194,46],{},[160,196,197],{},"Automatisch",[160,199,200],{},"Automatisch, aus demselben Release",[202,203,205],"h2",{"id":204},"so-funktioniert-es","So funktioniert es",[207,208,209,213,216],"ul",{},[210,211,212],"li",{},"Ein Hintergrunddienst hält die Verbindung zum Server und läuft auch bei ausgeschaltetem Bildschirm\nweiter; der Watchdog der App startet ihn neu, wenn Android ihn beendet.",[210,214,215],{},"SMS werden zuerst im Telefonspeicher abgelegt und an den Server gesendet, sobald er antwortet; so\ngeht bei einem Verbindungsabbruch nichts verloren.",[210,217,218,219,223],{},"Eine später eingelegte SIM wird von selbst gelistet; ",[220,221,222],"strong",{},"Abmelden"," nimmt die Nummern aus dem Verkauf.",[134,225,226,227,230],{},"Weiter: ",[228,229,93],"a",{"href":94},".",{"title":232,"searchDepth":233,"depth":233,"links":234},"",2,[235],{"id":204,"depth":233,"text":205},"Eine Android-App, die ein Telefon in ein eigenständiges Gateway verwandelt, das seine eigenen SIM-Karten verkauft.","md",null,{},{"title":89,"icon":84},{"title":83,"description":236},"0l2zLfaMbo0dZ6jPqQCHgljLn1C07tIg_KSDSZx-nVE",[238,244],{"title":93,"path":94,"description":245},"Die APK installieren, die Checkliste der Berechtigungen, der Geräteinhaber-Modus und die Anmeldung.",1794978319709]