headless\u002F1.serve","i-lucide-terminal",{"title":68,"path":69,"stem":70,"icon":71},"Web UI","\u002Fde\u002Fheadless\u002Fweb-ui","de\u002F2.headless\u002F2.web-ui","i-lucide-globe",{"title":73,"path":74,"stem":75,"icon":76},"Als Dienst betreiben","\u002Fde\u002Fheadless\u002Fservice","de\u002F2.headless\u002F3.service","i-lucide-server-cog",{"title":78,"path":79,"stem":80,"icon":81},"Netzwerkports","\u002Fde\u002Fheadless\u002Fnetwork-ports","de\u002F2.headless\u002F4.network-ports","i-lucide-network",{"title":83,"icon":84,"path":85,"stem":86,"children":87,"page":55},"Gateway Phone","i-lucide-smartphone","\u002Fde\u002Fphone","de\u002F3.phone",[88,92],{"title":89,"path":90,"stem":91,"icon":84},"Überblick","\u002Fde\u002Fphone\u002Foverview","de\u002F3.phone\u002F1.overview",{"title":93,"path":94,"stem":95,"icon":96},"Installation und Einrichtung","\u002Fde\u002Fphone\u002Fsetup","de\u002F3.phone\u002F2.setup","i-lucide-list-checks",{"title":98,"icon":81,"path":99,"stem":100,"children":101,"page":55},"Gateway Proxy","\u002Fde\u002Fproxy","de\u002F4.proxy",[102,105],{"title":89,"path":103,"stem":104,"icon":81},"\u002Fde\u002Fproxy\u002Foverview","de\u002F4.proxy\u002F1.overview",{"title":93,"path":106,"stem":107,"icon":96},"\u002Fde\u002Fproxy\u002Fsetup","de\u002F4.proxy\u002F2.setup",{"title":109,"icon":110,"path":111,"stem":112,"children":113,"page":55},"Hardware","i-lucide-cpu","\u002Fde\u002Fhardware","de\u002F5.hardware",[114,118],{"title":115,"path":116,"stem":117,"icon":110},"Unterstützte Modems","\u002Fde\u002Fhardware\u002Fmodems","de\u002F5.hardware\u002F1.modems",{"title":119,"path":120,"stem":121,"icon":122},"Treiber","\u002Fde\u002Fhardware\u002Fdrivers","de\u002F5.hardware\u002F2.drivers","i-lucide-usb",{"title":124,"path":125,"stem":126,"icon":127},"FAQ","\u002Fde\u002Ffaq","de\u002F6.faq","i-lucide-circle-help",{"id":129,"title":98,"body":130,"description":263,"extension":264,"links":265,"meta":266,"navigation":267,"path":103,"seo":268,"stem":104,"__hash__":269},"docs_de\u002Fde\u002F4.proxy\u002F1.overview.md",{"type":131,"value":132,"toc":258},"minimark",[133,142,145,161,223,228,245,251],[134,135,136,137,141],"p",{},"Gateway Proxy läuft auf einem Android-Telefon (8.0 oder neuer) und macht es zu einem SOCKS5- \u002F\nHTTP-Proxy. ",[138,139,140],"strong",{},"Der gesamte Proxy-Verkehr und sein DNS laufen nur über die mobilen Daten der SIM",", auch\nwenn das Telefon mit WLAN verbunden ist. Ohne mobile Daten werden Verbindungen abgelehnt; auf WLAN\nwird nie ausgewichen.",[134,143,144],{},"Der Proxy wird auf zwei Arten zugleich genutzt:",[146,147,148,155],"ul",{},[149,150,151,154],"li",{},[138,152,153],{},"Im eigenen WLAN:"," Geräte im selben Netz verbinden sich mit der Adresse des Telefons, Port 1080.",[149,156,157,160],{},[138,158,159],{},"Auf dem Marktplatz:"," Käufer erhalten eigene Ports über den Relay-Server. Das Telefon braucht\nkeine öffentliche IP und keine Portweiterleitung und funktioniert auch hinter dem NAT des Anbieters.",[162,163,164,177],"table",{},[165,166,167],"thead",{},[168,169,170,173,175],"tr",{},[171,172],"th",{},[171,174,83],{},[171,176,98],{},[178,179,180,192,203,213],"tbody",{},[168,181,182,186,189],{},[183,184,185],"td",{},"Verkauft",[183,187,188],{},"Die SIM-Karten des Telefons (SMS, Nummern)",[183,190,191],{},"Das mobile Internet der SIM",[168,193,194,197,200],{},[183,195,196],{},"Konto",[183,198,199],{},"E-Mail und Passwort des Verkäufers",[183,201,202],{},"API-Token des Verkäufers",[168,204,205,208,211],{},[183,206,207],{},"Läuft auf",[183,209,210],{},"Android 8.0+",[183,212,210],{},[168,214,215,217,220],{},[183,216,46],{},[183,218,219],{},"Automatisch",[183,221,222],{},"Automatisch, aus demselben Release",[224,225,227],"h2",{"id":226},"so-funktioniert-es","So funktioniert es",[146,229,230,233,239,242],{},[149,231,232],{},"Ein Hintergrunddienst hält Proxy und Relay-Verbindung bei ausgeschaltetem Bildschirm am Laufen; ein\nWächter startet ihn neu, wenn Android ihn beendet.",[149,234,235,238],{},[138,236,237],{},"Stop"," in der Benachrichtigung schaltet den Proxy aus, bis die App wieder geöffnet wird.",[149,240,241],{},"Der Hauptbildschirm zeigt Adresse, Login und Passwort, die externe IP der SIM, Verbindungen und\nVerkehr ↑\u002F↓ für den WLAN-Port und für Käufer sowie Warnungen mit Lösung (keine mobilen Daten,\nDatensparmodus, Akkuoptimierung, kein WLAN).",[149,243,244],{},"Datenkontingent und Geschwindigkeitslimits werden nur am Telefon eingestellt.",[246,247,248],"warning",{},[134,249,250],{},"In 0.9.0 ist die eingebaute Relay-Adresse ein Platzhalter, daher funktioniert der Verkauf auf dem\nMarktplatz noch nicht. Der Proxy im WLAN funktioniert. Die Adresse kommt mit dem nächsten Release.",[134,252,253,254,257],{},"Weiter: ",[255,256,93],"a",{"href":106},".",{"title":259,"searchDepth":260,"depth":260,"links":261},"",2,[262],{"id":226,"depth":260,"text":227},"Eine Android-App, die ein Telefon zu einem SOCKS5- \u002F HTTP-Proxy über seine SIM macht und ihn auf dem Marktplatz verkauft.","md",null,{},{"title":89,"icon":81},{"title":98,"description":263},"boj8Q1xcV8f1zn75kFksxqbFY3WgMYqeHWJmBZmVlMs",[265,271],{"title":93,"path":106,"description":272},"Die APK installieren, im Hintergrund laufen lassen, Clients verbinden, verkaufen, Limits und mehrere SIMs.",1794978319996]