h__":269},"docs_ru\u002Fru\u002F4.proxy\u002F1.overview.md",{"type":131,"value":132,"toc":258},"minimark",[133,142,145,161,223,228,245,251],[134,135,136,137,141],"p",{},"Gateway Proxy работает на Android-телефоне (8.0 и новее) и превращает его в SOCKS5 \u002F HTTP-прокси.\n",[138,139,140],"strong",{},"Весь трафик прокси и его DNS идут только через мобильный интернет SIM",", даже когда телефон\nподключён к Wi-Fi. Без мобильного интернета подключения отклоняются; на Wi-Fi прокси не переключается\nникогда.",[134,143,144],{},"Прокси работает сразу в двух режимах:",[146,147,148,155],"ul",{},[149,150,151,154],"li",{},[138,152,153],{},"В вашей Wi-Fi-сети:"," устройства той же сети подключаются к адресу телефона на порт 1080.",[149,156,157,160],{},[138,158,159],{},"На маркетплейсе:"," покупатели получают собственные порты через сервер-релей. Телефону не нужны\nбелый IP и проброс портов, он работает и за NAT оператора.",[162,163,164,177],"table",{},[165,166,167],"thead",{},[168,169,170,173,175],"tr",{},[171,172],"th",{},[171,174,83],{},[171,176,98],{},[178,179,180,192,203,213],"tbody",{},[168,181,182,186,189],{},[183,184,185],"td",{},"Продаёт",[183,187,188],{},"SIM-карты телефона (SMS, номера)",[183,190,191],{},"Мобильный интернет SIM",[168,193,194,197,200],{},[183,195,196],{},"Аккаунт",[183,198,199],{},"Email и пароль продавца",[183,201,202],{},"API-токен продавца",[168,204,205,208,211],{},[183,206,207],{},"Работает на",[183,209,210],{},"Android 8.0+",[183,212,210],{},[168,214,215,217,220],{},[183,216,46],{},[183,218,219],{},"Автоматически",[183,221,222],{},"Автоматически, из того же релиза",[224,225,227],"h2",{"id":226},"как-это-работает","Как это работает",[146,229,230,233,239,242],{},[149,231,232],{},"Фоновый сервис держит прокси и связь с релеем при выключенном экране; сторож перезапускает его,\nесли Android его остановил.",[149,234,235,238],{},[138,236,237],{},"Остановить"," в уведомлении выключает прокси до следующего открытия приложения.",[149,240,241],{},"На главном экране — адрес, логин и пароль, внешний IP SIM, подключения и трафик ↑\u002F↓ для\nWi-Fi-порта и для покупателей, предупреждения с кнопкой исправления (нет мобильного интернета,\nэкономия трафика, оптимизация батареи, нет Wi-Fi).",[149,243,244],{},"Квота трафика и ограничения скорости задаются только на телефоне.",[246,247,248],"warning",{},[134,249,250],{},"В 0.9.0 адрес релея, встроенный в приложение, — заглушка, поэтому продажа на маркетплейсе пока не\nработает. Прокси в Wi-Fi-сети работает. Адрес появится в следующем релизе.",[134,252,253,254,257],{},"Дальше: ",[255,256,93],"a",{"href":106},".",{"title":259,"searchDepth":260,"depth":260,"links":261},"",2,[262],{"id":226,"depth":260,"text":227},"Android-приложение, которое превращает телефон в SOCKS5 \u002F HTTP-прокси через SIM и продаёт его на маркетплейсе.","md",null,{},{"title":89,"icon":81},{"title":98,"description":263},"VSHPhvn0341m8u3oiSYwW4CuXIQAgIbBcY1Uury_CeQ",[265,271],{"title":93,"path":106,"description":272},"Установка APK, работа в фоне, подключение клиентов, продажа, лимиты и несколько SIM.",1794978318804]