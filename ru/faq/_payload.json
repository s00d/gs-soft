F6.faq.md",{"type":131,"value":132,"toc":237},"minimark",[133,138,147,151,154,158,186,190,198,202,205,209,219,223],[134,135,137],"h2",{"id":136},"чем-приложение-для-пк-отличается-от-режима-без-окна","Чем приложение для ПК отличается от режима без окна?",[139,140,141,142,146],"p",{},"Только окном. Режим без окна — та же программа, запущенная с ",[143,144,145],"code",{},"--serve",": без окна и трея, интерфейс\nв браузере. Оба продают номера, оба обновляются сами.",[134,148,150],{"id":149},"нужен-ли-отдельный-аккаунт-для-каждого-компьютера-или-телефона","Нужен ли отдельный аккаунт для каждого компьютера или телефона?",[139,152,153],{},"Нет. Входите везде под одним аккаунтом продавца; каждый шлюз отображается как отдельное оборудование\nи выставляет свои SIM.",[134,155,157],{"id":156},"какой-файл-скачать","Какой файл скачать?",[139,159,160,165,166,169,170,173,174,177,178,181,182,185],{},[161,162,164],"a",{"href":163},"\u002Fru\u002Fdownloads","Страница загрузок"," показывает вашу систему первой. Если сомневаетесь: Windows\n",[143,167,168],{},"x64-setup.exe",", macOS ",[143,171,172],{},"universal.dmg",", Linux ",[143,175,176],{},"amd64.AppImage"," или ",[143,179,180],{},".deb",", телефон\n",[143,183,184],{},"Gateway.Phone_…_universal.apk",".",[134,187,189],{"id":188},"сколько-модемов-может-обслуживать-один-шлюз","Сколько модемов может обслуживать один шлюз?",[139,191,192,193,197],{},"Сотни портов; ограничение скорее в питании и пропускной способности USB, чем в программе. ",[194,195,196],"strong",{},"Настройки →\nПодключения"," ограничивает, сколько портов одновременно выставляют номера на слабом железе.",[134,199,201],{"id":200},"работает-ли-без-интернета","Работает ли без интернета?",[139,203,204],{},"Модемы продолжают работать, входящие SMS сохраняются; когда сервер снова доступен, номера\nвозвращаются в продажу, а SMS доставляются.",[134,206,208],{"id":207},"открыт-ли-исходный-код","Открыт ли исходный код?",[139,210,211,212,218],{},"Нет. Gateway Soft распространяется в виде подписанных бинарных файлов; этот сайт и\n",[161,213,217],{"href":214,"rel":215},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fgs-soft\u002Freleases",[216],"nofollow","релизы"," публичны.",[134,220,222],{"id":221},"куда-сообщить-о-проблеме","Куда сообщить о проблеме?",[139,224,225,226,229,230,233,234,236],{},"Соберите ",[143,227,228],{},"logs\u002Fmain.log"," с уровнем логов ",[143,231,232],{},"debug","\n(",[161,235,51],{"href":52},") и отправьте его в поддержку вместе с версией\nприложения.",{"title":238,"searchDepth":239,"depth":239,"links":240},"",2,[241,242,243,244,245,246,247],{"id":136,"depth":239,"text":137},{"id":149,"depth":239,"text":150},{"id":156,"depth":239,"text":157},{"id":188,"depth":239,"text":189},{"id":200,"depth":239,"text":201},{"id":207,"depth":239,"text":208},{"id":221,"depth":239,"text":222},"Короткие ответы на самые частые вопросы.","md",null,{},{"icon":127},{"title":124,"description":248},"PPv5XVBsOhpe-oE6zEp8QWp_uKUfmJlsumcp9FzCiqY",[250,250],1794978318682]