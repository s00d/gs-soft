terial-theme material-theme-palenight","pnputil \u002Fadd-driver \"CH341SER\\WIN 1X\\CH341SER.INF\" \u002Finstall\n","powershell","",[138,252,253],{"__ignoreMap":250},[254,255,258],"span",{"class":256,"line":257},"line",1,[254,259,248],{},[134,261,262,263,266,267,270,271,274],{},"После этого ",[190,264,265],{},"Диспетчер устройств → Порты (COM и LPT)"," показывает ",[190,268,269],{},"USB-SERIAL CH340 (COMn)",", а порт\nпоявляется в ",[190,272,273],{},"Список портов → Добавить",".",[237,276,204],{"id":277},"macos",[134,279,280,281,284,285,274],{},"Установите ",[138,282,283],{},"CH34xVCPDriver.pkg"," из архива, затем разрешите системное расширение в ",[190,286,287],{},"Системные\nнастройки → Конфиденциальность и безопасность",[237,289,226],{"id":290},"linux",[134,292,293,294,297,298,301],{},"Подключите плату и проверьте ",[138,295,296],{},"ls \u002Fdev\u002FttyUSB*",". Для доступа добавьте своего пользователя в ",[138,299,300],{},"dialout",":",[245,303,307],{"className":304,"code":305,"language":306,"meta":250,"style":250},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo usermod -aG dialout \"$USER\"\n","bash",[138,308,309],{"__ignoreMap":250},[254,310,311,315,319,322,325,329,333],{"class":256,"line":257},[254,312,314],{"class":313},"sBMFI","sudo",[254,316,318],{"class":317},"sfazB"," usermod",[254,320,321],{"class":317}," -aG",[254,323,324],{"class":317}," dialout",[254,326,328],{"class":327},"sMK4o"," \"",[254,330,332],{"class":331},"sTEyZ","$USER",[254,334,335],{"class":327},"\"\n",[237,337,339],{"id":338},"другие-чипы-usb-serial","Другие чипы USB-serial",[134,341,342,343,346,347,350,351,274],{},"Чип определяется по USB ID: в Windows ",[190,344,345],{},"Диспетчер устройств → устройство → Сведения → ИД оборудования",",\nв Linux ",[138,348,349],{},"lsusb",", в macOS ",[190,352,353],{},"Информация о системе → USB",[143,355,356,372],{},[146,357,358],{},[149,359,360,363,366,368,370],{},[152,361,362],{},"USB ID",[152,364,365],{},"Чип",[152,367,240],{},[152,369,204],{},[152,371,226],{},[162,373,374,408,435,465],{},[149,375,376,385,388,396,401],{},[167,377,378,381,382],{},[138,379,380],{},"1a86:55d2"," – ",[138,383,384],{},"55ef",[167,386,387],{},"WCH CH342 \u002F CH343 \u002F CH9102 \u002F CH9143",[167,389,390,391],{},"В Windows 10+ работает без драйвера; в старых: ",[176,392,395],{"href":393,"rel":394},"https:\u002F\u002Fwww.wch-ic.com\u002Fdownloads\u002FCH343SER_ZIP.html",[180],"CH343SER.ZIP",[167,397,398],{},[176,399,221],{"href":219,"rel":400},[180],[167,402,403,404,407],{},"встроен (",[138,405,406],{},"\u002Fdev\u002FttyACM*",")",[149,409,410,415,418,426,432],{},[167,411,412],{},[138,413,414],{},"10c4:ea60",[167,416,417],{},"Silicon Labs CP2102 \u002F CP2104 \u002F CP210x",[167,419,420,421],{},"Центр обновления Windows или ",[176,422,425],{"href":423,"rel":424},"https:\u002F\u002Fwww.silabs.com\u002Fsoftware-and-tools\u002Fusb-to-uart-bridge-vcp-drivers",[180],"CP210x Universal",[167,427,428],{},[176,429,431],{"href":423,"rel":430},[180],"VCP-драйвер для macOS",[167,433,434],{},"встроен",[149,436,437,449,452,460,463],{},[167,438,439,442,443,381,446],{},[138,440,441],{},"067b:2303",", ",[138,444,445],{},"067b:23a3",[138,447,448],{},"23e3",[167,450,451],{},"Prolific PL2303",[167,453,454,459],{},[176,455,458],{"href":456,"rel":457},"https:\u002F\u002Fwww.prolific.com.tw\u002Fen\u002Fportfolio-item\u002Fpl2303gd\u002F",[180],"Установщик PL23XX"," (для серии G на ARM64 — отдельный)",[167,461,462],{},"«PL2303 Serial» в Mac App Store",[167,464,434],{},[149,466,467,473,476,483,485],{},[167,468,469,472],{},[138,470,471],{},"0403:6001"," и другие",[167,474,475],{},"FTDI FT232 \u002F FT-X",[167,477,420,478],{},[176,479,482],{"href":480,"rel":481},"https:\u002F\u002Fftdichip.com\u002Fdrivers\u002Fvcp-drivers\u002F",[180],"VCP-драйвер",[167,484,434],{},[167,486,434],{},[134,488,489],{},"Старые поддельные адаптеры PL2303HX («PHASED OUT», код 10 в диспетчере устройств) с текущими драйверами\nWindows не работают: замените адаптер на CH340 или CP2102.",[237,491,493],{"id":492},"модемы-со-своим-usb","Модемы со своим USB",[134,495,496],{},"Модемам Quectel, SIMCom, Huawei и ZTE, подключённым напрямую (без платы USB-serial), в Linux и macOS\nдрайвер не нужен. В Windows поставьте USB-драйвер производителя модема: для многих модулей Quectel он\nесть в Центре обновления Windows; иначе спросите у продавца модема или возьмите с виртуального диска\nсамого модема (Huawei, ZTE).",[498,499,500],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s