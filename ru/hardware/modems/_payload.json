hash__":266},"docs_ru\u002Fru\u002F5.hardware\u002F1.modems.md",{"type":131,"value":132,"toc":255},"minimark",[133,137,205,213,218],[134,135,136],"p",{},"Шлюз распознаёт модель модема по его ответам и выбирает профиль: какие команды он поддерживает, как\nсообщает об SMS, USSD и SIM и какие обходные решения ему нужны.",[138,139,140,153],"table",{},[141,142,143],"thead",{},[144,145,146,150],"tr",{},[147,148,149],"th",{},"Семейство",[147,151,152],{},"Примеры",[154,155,156,165,173,181,189,197],"tbody",{},[144,157,158,162],{},[159,160,161],"td",{},"Quectel",[159,163,164],{},"EC20, EC25, M35 и другие модули LTE \u002F 2G",[144,166,167,170],{},[159,168,169],{},"SIMCom",[159,171,172],{},"Серия SIM800, A76xx",[144,174,175,178],{},[159,176,177],{},"Huawei",[159,179,180],{},"USB-модемы (серия E)",[144,182,183,186],{},[159,184,185],{},"ZTE",[159,187,188],{},"USB-модемы",[144,190,191,194],{},[159,192,193],{},"Wavecom",[159,195,196],{},"Промышленные GSM-модемы",[144,198,199,202],{},[159,200,201],{},"Другие",[159,203,204],{},"Fibocom, AirM2M, Alcatel, платы на Spreadtrum",[134,206,207,208,212],{},"Модем вне этих семейств в большинстве случаев всё равно работает через общий профиль. ",[209,210,211],"strong",{},"Настройки →\nМодем и кодировки → Только модемы из матрицы"," вместо этого отклоняет неизвестные модели.",[214,215,217],"h2",{"id":216},"выбор-модемов","Выбор модемов",[219,220,221,228,234,249],"ul",{},[222,223,224,227],"li",{},[209,225,226],{},"Модули только с 2G"," перестают работать там, где операторы отключают 2G; лучше берите LTE-модули\nс SMS через IMS \u002F CS fallback.",[222,229,230,233],{},[209,231,232],{},"Питание",": многие платы при регистрации потребляют больше, чем даёт порт USB-хаба. Используйте хаб\nс внешним питанием.",[222,235,236,239,240,244,245,248],{},[209,237,238],{},"Чип USB-serial",": платам на CH340 нужен драйвер в Windows ARM64 и драйвер WCH в macOS для\n",[241,242,243],"code",{},"\u002Fdev\u002Fcu.wchusbserial*","; см. ",[246,247,119],"a",{"href":120},".",[222,250,251,254],{},[209,252,253],{},"Антенны",": слабый сигнал проявляется в том, что SIM не регистрируются или теряют SMS.",{"title":256,"searchDepth":257,"depth":257,"links":258},"",2,[259],{"id":216,"depth":257,"text":217},"Семейства модемов, которые знает шлюз, и на что смотреть при покупке модемов для фермы.","md",null,{},{"icon":110},{"title":115,"description":260},"ZOPq9zb3KgQBH2h1vKNbBmkmoR5u9bQzV7-t5ZVYcFA",[262,268],{"title":119,"path":120,"description":269},"Драйверы USB-serial для плат модемов в Windows, macOS и Linux.",1794978318835]