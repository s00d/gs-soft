_":242},"docs_ru\u002Fru\u002F3.phone\u002F1.overview.md",{"type":131,"value":132,"toc":231},"minimark",[133,137,201,206,224],[134,135,136],"p",{},"Gateway Phone работает на Android-телефоне (8.0 или новее) так же, как шлюз на ПК, но без\nкомпьютера: входит в ваш аккаунт продавца, выставляет SIM-карты телефона на продажу, принимает SMS\nи пересылает их на сервер.",[138,139,140,154],"table",{},[141,142,143],"thead",{},[144,145,146,149,152],"tr",{},[147,148],"th",{},[147,150,151],{},"Шлюз на ПК",[147,153,83],{},[155,156,157,169,180,191],"tbody",{},[144,158,159,163,166],{},[160,161,162],"td",{},"SIM-карты",[160,164,165],{},"USB-модемы",[160,167,168],{},"Собственные слоты SIM телефона (включая dual SIM)",[144,170,171,174,177],{},[160,172,173],{},"Платформа",[160,175,176],{},"Windows, macOS, Linux",[160,178,179],{},"Android 8.0+",[144,181,182,185,188],{},[160,183,184],{},"Аккаунт",[160,186,187],{},"Аккаунт продавца",[160,189,190],{},"Тот же аккаунт продавца",[144,192,193,195,198],{},[160,194,46],{},[160,196,197],{},"Автоматически",[160,199,200],{},"Автоматически, из того же релиза",[202,203,205],"h2",{"id":204},"как-это-работает","Как это работает",[207,208,209,213,216],"ul",{},[210,211,212],"li",{},"Фоновая служба держит соединение с сервером и продолжает работать при выключенном экране;\nсторожевой механизм приложения перезапускает её, если Android её остановил.",[210,214,215],{},"SMS сначала записываются в память телефона и отправляются на сервер, как только он ответит, поэтому\nпри обрыве связи ничего не теряется.",[210,217,218,219,223],{},"SIM, вставленная позже, выставляется сама; ",[220,221,222],"strong",{},"Выйти"," снимает номера с продажи.",[134,225,226,227,230],{},"Далее: ",[228,229,93],"a",{"href":94},".",{"title":232,"searchDepth":233,"depth":233,"links":234},"",2,[235],{"id":204,"depth":233,"text":205},"Android-приложение, которое превращает телефон в самостоятельный шлюз, продающий собственные SIM-карты.","md",null,{},{"title":89,"icon":84},{"title":83,"description":236},"G9p_rrpUQlJTS-hAo6mLrfQnrh5OR9uwuMOIw_-7FZY",[238,244],{"title":93,"path":94,"description":245},"Установка APK, чек-лист разрешений, режим владельца устройства и вход.",1794978318770]