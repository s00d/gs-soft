:231},"docs_ru\u002Fru\u002F1.guide\u002F8.updates.md",{"type":131,"value":132,"toc":220},"minimark",[133,145,201,204,209],[134,135,136,137,144],"p",{},"Новые версии публикуются на ",[138,139,143],"a",{"href":140,"rel":141},"https:\u002F\u002Fgithub.com\u002Fs00d\u002Fgs-soft\u002Freleases",[142],"nofollow","странице релизов","; каждая\nредакция проверяет её сама.",[146,147,148,161],"table",{},[149,150,151],"thead",{},[152,153,154,158],"tr",{},[155,156,157],"th",{},"Редакция",[155,159,160],{},"Как обновляется",[162,163,164,173,186,193],"tbody",{},[152,165,166,170],{},[167,168,169],"td",{},"Приложение для ПК (Windows, macOS, Linux x86_64 \u002F ARM64 \u002F ARMv7)",[167,171,172],{},"Проверяет каждые 10 минут, в фоне скачивает и устанавливает обновление, затем сообщает об этом; новая версия запускается при следующем перезапуске (трей → Перезапуск или выйти и запустить снова).",[152,174,175,183],{},[167,176,177,178,182],{},"Без окна (",[179,180,181],"code",{},"--serve",")",[167,184,185],{},"Тот же механизм обновления; в Windows установщик работает в пассивном режиме. Чтобы перейти на новую версию, перезапустите службу.",[152,187,188,190],{},[167,189,83],{},[167,191,192],{},"Телефон проверяет релиз при запуске и регулярно после, и устанавливает новый APK (Android просит подтверждения, если приложение не владелец устройства).",[152,194,195,198],{},[167,196,197],{},"Android (интерфейс ПК)",[167,199,200],{},"Проверяет релиз при запуске и каждые 10 минут, скачивает и проверяет новый APK, затем открывает установщик Android для подтверждения. В первый раз Android попросит разрешить установку приложений из Gateway Soft.",[134,202,203],{},"Каждое обновление подписано; приложение отклоняет файл, не подписанный ключом Gateway Soft.",[205,206,208],"h2",{"id":207},"обновление-вручную","Обновление вручную",[134,210,211,212,215,216,219],{},"Скачайте установщик новой версии и запустите его поверх старой: настройки, сессия и добавленные порты\nсохранятся. В Linux установите новый ",[179,213,214],{},".deb"," \u002F ",[179,217,218],{},".rpm"," так же, как в первый раз.",{"title":221,"searchDepth":222,"depth":222,"links":223},"",2,[224],{"id":207,"depth":222,"text":208},"Как обновляется каждая редакция и как обновить вручную.","md",null,{},{"icon":49},{"title":46,"description":225},"BdbJs4XPNmWJxT5hfA3mgH4iDTbA6npQH0DOMmbgDXo",[233,235],{"title":41,"path":42,"description":234},"Доход, выводы средств и статистика продаж вашего аккаунта.",{"title":51,"path":52,"description":236},"Типичные проблемы и куда смотреть в первую очередь.",1794978315799]