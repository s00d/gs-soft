:305},"docs_ru\u002Fru\u002F1.guide\u002F4.selling.md",{"type":131,"value":132,"toc":291},"minimark",[133,138,173,184,188,194,198,273,280,284],[134,135,137],"h2",{"id":136},"от-sim-до-продажи","От SIM до продажи",[139,140,141,150,170],"ol",{},[142,143,144,145,149],"li",{},"Шлюз читает SIM (IMSI, ICCID) и находит номер: на самой SIM, в её телефонной книге или с помощью\nUSSD-запроса оператора (",[146,147,148],"code",{},"*…#","). Номер всегда можно ввести вручную в панели подробностей.",[142,151,152,153,157,158,161,162,165,166,169],{},"Если включено ",[154,155,156],"strong",{},"Автоподключение"," (",[154,159,160],{},"Настройки → Общие","), номер отправляется на сервер, порт\nпереходит в ",[154,163,164],{},"В очереди",", а затем в ",[154,167,168],{},"Онлайн",", когда сервер начинает его продавать.",[142,171,172],{},"SMS покупателей приходят на модем; шлюз сразу пересылает их на сервер. SMS, пришедшие, пока\nсервер недоступен, сохраняются и отправляются позже.",[174,175,176],"tip",{},[177,178,179,180,183],"p",{},"Оставьте автоподключение выключенным, чтобы сначала проверить новые SIM; затем выставляйте отдельные\nпорты кнопкой ",[154,181,182],{},"Сбросить ошибки и переподключить",".",[134,185,187],{"id":186},"аренда","Аренда",[177,189,190,191,193],{},"Переключатель ",[154,192,187],{}," в панели подробностей предлагает номер не только для разовых активаций,\nно и в долгосрочную аренду. Выбор сохраняется для каждого порта между перезапусками.",[134,195,197],{"id":196},"ответы-сервера","Ответы сервера",[199,200,201,217],"table",{},[202,203,204],"thead",{},[205,206,207,211,214],"tr",{},[208,209,210],"th",{},"Показано",[208,212,213],{},"Что произошло",[208,215,216],{},"Что делать",[218,219,220,234,247,260],"tbody",{},[205,221,222,228,231],{},[223,224,225],"td",{},[154,226,227],{},"Номер уже использовался",[223,229,230],{},"Сервер отказывает в аренде номера, который уже работал на активациях.",[223,232,233],{},"Выключите аренду для этого порта.",[205,235,236,241,244],{},[223,237,238],{},[154,239,240],{},"Номер заблокирован",[223,242,243],{},"У номера набралось слишком много неудачных активаций.",[223,245,246],{},"Сервер снимает блокировки при ночном сбросе.",[205,248,249,254,257],{},[223,250,251],{},[154,252,253],{},"Сервис заблокирован",[223,255,256],{},"Один сервис (например, мессенджер) заблокировал номер.",[223,258,259],{},"Ничего; номер продолжает продаваться другим сервисам.",[205,261,262,267,270],{},[223,263,264],{},[154,265,266],{},"Порт неактивен",[223,268,269],{},"Сервер отключил выставление номера.",[223,271,272],{},"Проверьте номер и аккаунт, затем переподключите.",[177,274,275,276,279],{},"Порт, которому сервер отказал, не отправляется повторно циклом автоподключения; ",[154,277,278],{},"Сбросить ошибки и\nпереподключить"," намеренно пробует снова.",[134,281,283],{"id":282},"смена-номера","Смена номера",[177,285,286,287,290],{},"После замены SIM или переноса номера используйте ",[154,288,289],{},"Очистить номер"," на порту: старый номер снимается\nс продажи, а новый считывается и выставляется.",{"title":292,"searchDepth":293,"depth":293,"links":294},"",2,[295,296,297,298],{"id":136,"depth":293,"text":137},{"id":186,"depth":293,"text":187},{"id":196,"depth":293,"text":197},{"id":282,"depth":293,"text":283},"Как SIM-карта становится номером в продаже, автоподключение, аренда и что означают ответы сервера.","md",null,{},{"icon":29},{"title":26,"description":299},"nO3huRVLROY-T-qM2DKdCZ6tf695NF219T-_wGcDs3c",[307,309],{"title":21,"path":22,"description":308},"Добавление портов, список портов и что означает каждый статус.",{"title":31,"path":32,"description":310},"Входящие SMS порта, USSD-запросы и как научить шлюз кодам своего номера и баланса для оператора.",1794978318930]