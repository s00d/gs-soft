m":53,"__hash__":302},"docs_ru\u002Fru\u002F1.guide\u002F9.troubleshooting.md",{"type":131,"value":132,"toc":288},"minimark",[133,138,175,179,187,243,247,265,269],[134,135,137],"h2",{"id":136},"модема-нет-в-списке-добавить","Модема нет в списке «Добавить»",[139,140,141,145,157,172],"ul",{},[142,143,144],"li",{},"Проверьте кабель и питание: платам модемов часто нужно больше тока, чем даёт USB-хаб.",[142,146,147,151,152,156],{},[148,149,150],"strong",{},"Windows ARM64, macOS",": платам на CH340 нужен ",[153,154,155],"a",{"href":120},"драйвер производителя",".",[142,158,159,162,163,167,168,171],{},[148,160,161],{},"Linux",": ваш пользователь должен быть в группе ",[164,165,166],"code",{},"dialout"," (",[164,169,170],{},"sudo usermod -aG dialout \"$USER\"",", затем\nвойдите заново).",[142,173,174],{},"Порт может держать другая программа (терминал, другой шлюз): закройте её.",[134,176,178],{"id":177},"порт-остаётся-в-статусе-проблемы","Порт остаётся в статусе «Проблемы»",[180,181,182,183,186],"p",{},"Откройте порт: баннер сообщает, что произошло. ",[148,184,185],{},"Показать ошибку"," выводит полный текст. Частые случаи:",[188,189,190,203],"table",{},[191,192,193],"thead",{},[194,195,196,200],"tr",{},[197,198,199],"th",{},"Сообщение",[197,201,202],{},"Причина",[204,205,206,215,223,235],"tbody",{},[194,207,208,212],{},[209,210,211],"td",{},"SIM не вставлена \u002F нужен PIN",[209,213,214],{},"Вставьте SIM без PIN-кода.",[194,216,217,220],{},[209,218,219],{},"Нет регистрации в сети",[209,221,222],{},"Слабый сигнал или неподдерживаемый диапазон; проверьте антенну.",[194,224,225,228],{},[209,226,227],{},"Номер не найден",[209,229,230,231,234],{},"Задайте USSD своего номера для оператора в ",[148,232,233],{},"Настройки → USSD команды"," или введите номер вручную.",[194,236,237,240],{},[209,238,239],{},"Номер уже использовался",[209,241,242],{},"Аренда для этого номера не разрешена; выключите аренду.",[134,244,246],{"id":245},"номера-не-выставляются-на-продажу","Номера не выставляются на продажу",[139,248,249,258],{},[142,250,251,254,255,156],{},[148,252,253],{},"Автоподключение"," должно быть включено, или выставляйте порты кнопкой ",[148,256,257],{},"Сбросить ошибки и\nпереподключить",[142,259,260,261,264],{},"Верхняя панель показывает связь с сервером; ",[148,262,263],{},"Сервер офлайн"," означает, что пропал интернет или\nсервер недоступен, — шлюз переподключится сам.",[134,266,268],{"id":267},"логи-для-поддержки","Логи для поддержки",[180,270,271,272,275,276,279,280,283,284,156],{},"Установите ",[148,273,274],{},"Настройки → Подключение и логи → Уровень логов"," в ",[164,277,278],{},"debug",", воспроизведите проблему и\nотправьте ",[164,281,282],{},"logs\u002Fmain.log"," из ",[153,285,287],{"href":286},"\u002Fru\u002Fguide\u002Finstall#%D0%B3%D0%B4%D0%B5-%D1%85%D1%80%D0%B0%D0%BD%D1%8F%D1%82%D1%81%D1%8F-%D0%B4%D0%B0%D0%BD%D0%BD%D1%8B%D0%B5","папки данных",{"title":289,"searchDepth":290,"depth":290,"links":291},"",2,[292,293,294,295],{"id":136,"depth":290,"text":137},{"id":177,"depth":290,"text":178},{"id":245,"depth":290,"text":246},{"id":267,"depth":290,"text":268},"Типичные проблемы и куда смотреть в первую очередь.","md",null,{},{"icon":54},{"title":51,"description":296},"acdulyfZj4QwhPphsNxEuE15fYdKUHqCSY7VvT9dND4",[304,298],{"title":46,"path":47,"description":305},"Как обновляется каждая редакция и как обновить вручную.",1794978319126]