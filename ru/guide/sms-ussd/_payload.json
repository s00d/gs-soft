02F1.serve","i-lucide-terminal",{"title":68,"path":69,"stem":70,"icon":71},"Web UI","\u002Fru\u002Fheadless\u002Fweb-ui","ru\u002F2.headless\u002F2.web-ui","i-lucide-globe",{"title":73,"path":74,"stem":75,"icon":76},"Запуск как служба","\u002Fru\u002Fheadless\u002Fservice","ru\u002F2.headless\u002F3.service","i-lucide-server-cog",{"title":78,"path":79,"stem":80,"icon":81},"Сетевые порты","\u002Fru\u002Fheadless\u002Fnetwork-ports","ru\u002F2.headless\u002F4.network-ports","i-lucide-network",{"title":83,"icon":84,"path":85,"stem":86,"children":87,"page":55},"Gateway Phone","i-lucide-smartphone","\u002Fru\u002Fphone","ru\u002F3.phone",[88,92],{"title":89,"path":90,"stem":91,"icon":84},"Обзор","\u002Fru\u002Fphone\u002Foverview","ru\u002F3.phone\u002F1.overview",{"title":93,"path":94,"stem":95,"icon":96},"Установка и настройка","\u002Fru\u002Fphone\u002Fsetup","ru\u002F3.phone\u002F2.setup","i-lucide-list-checks",{"title":98,"icon":81,"path":99,"stem":100,"children":101,"page":55},"Gateway Proxy","\u002Fru\u002Fproxy","ru\u002F4.proxy",[102,105],{"title":89,"path":103,"stem":104,"icon":81},"\u002Fru\u002Fproxy\u002Foverview","ru\u002F4.proxy\u002F1.overview",{"title":93,"path":106,"stem":107,"icon":96},"\u002Fru\u002Fproxy\u002Fsetup","ru\u002F4.proxy\u002F2.setup",{"title":109,"icon":110,"path":111,"stem":112,"children":113,"page":55},"Оборудование","i-lucide-cpu","\u002Fru\u002Fhardware","ru\u002F5.hardware",[114,118],{"title":115,"path":116,"stem":117,"icon":110},"Поддерживаемые модемы","\u002Fru\u002Fhardware\u002Fmodems","ru\u002F5.hardware\u002F1.modems",{"title":119,"path":120,"stem":121,"icon":122},"Драйверы","\u002Fru\u002Fhardware\u002Fdrivers","ru\u002F5.hardware\u002F2.drivers","i-lucide-usb",{"title":124,"path":125,"stem":126,"icon":127},"Вопросы и ответы","\u002Fru\u002Ffaq","ru\u002F6.faq","i-lucide-circle-help",{"id":129,"title":31,"body":130,"description":235,"extension":236,"links":237,"meta":238,"navigation":239,"path":32,"seo":240,"stem":33,"__hash__":241},"docs_ru\u002Fru\u002F1.guide\u002F5.sms-ussd.md",{"type":131,"value":132,"toc":227},"minimark",[133,138,146,150,166,170,185,201,208,212,218],[134,135,137],"h2",{"id":136},"входящие-sms","Входящие SMS",[139,140,141,145],"p",{},[142,143,144],"strong",{},"SMS на модеме"," показывает, что получила SIM-карта порта. Сообщения для покупателей пересылаются на\nсервер автоматически; этот список нужен, чтобы проверить SIM вручную.",[134,147,149],{"id":148},"ussd","USSD",[139,151,152,153,157,158,161,162,165],{},"Отправьте любой USSD-запрос (",[154,155,156],"code",{},"*100#",", ",[154,159,160],{},"*111*0887#",", …) из панели подробностей порта или сразу на\nмного портов через ",[142,163,164],{},"Ещё → Массовый USSD",". Ответ появится в логе порта.",[134,167,169],{"id":168},"коды-своего-номера-и-баланса","Коды своего номера и баланса",[139,171,172,173,176,177,180,181,184],{},"Шлюз знает коды многих операторов. Для остальных задайте их один раз в ",[142,174,175],{},"Настройки → USSD команды",",\nдля каждого оператора (",[154,178,179],{},"MCC:MNC",", например ",[154,182,183],{},"250:11","):",[186,187,188,195],"ul",{},[189,190,191,194],"li",{},[142,192,193],{},"Свой номер"," — запрос, в ответе на который есть номер SIM; используется, когда сама SIM его не\nхранит.",[189,196,197,200],{},[142,198,199],{},"Баланс"," — показывается в подробностях порта.",[139,202,203,204,207],{},"Если удалить запись, снова будет использоваться встроенный код. Мусор в ответах (префиксы,\nразделители) очищается автоматически; дополнительные шаблоны задаются в ",[142,205,206],{},"Настройки → Номера и IMSI",".",[134,209,211],{"id":210},"инструменты-отладки","Инструменты отладки",[139,213,214,217],{},[142,215,216],{},"Отладка"," открывает низкоуровневые инструменты для порта, который не в работе: AT-консоль с\nпресетами, Lua-скрипты, проверки модема, редактор SMS и состояние порта. Используйте их только для\nдиагностики: порт в режиме отладки не продаётся.",[139,219,220],{},[221,222],"img",{"alt":223,"className":224,"src":226},"AT-консоль",[225],"prose-shot","\u002Fscreenshots\u002Fru\u002F03_at_console.png",{"title":228,"searchDepth":229,"depth":229,"links":230},"",2,[231,232,233,234],{"id":136,"depth":229,"text":137},{"id":148,"depth":229,"text":149},{"id":168,"depth":229,"text":169},{"id":210,"depth":229,"text":211},"Входящие SMS порта, USSD-запросы и как научить шлюз кодам своего номера и баланса для оператора.","md",null,{},{"icon":34},{"title":31,"description":235},"BIIT2rQ_gEaYjf21JdOM5OmcXpB9igNiuDe-VykOcMQ",[243,245],{"title":26,"path":27,"description":244},"Как SIM-карта становится номером в продаже, автоподключение, аренда и что означают ответы сервера.",{"title":36,"path":37,"description":246},"Настройки, которые нужны каждый день, сгруппированные как в приложении.",1794978318957]