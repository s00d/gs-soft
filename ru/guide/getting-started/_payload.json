m":13,"__hash__":248},"docs_ru\u002Fru\u002F1.guide\u002F1.getting-started.md",{"type":131,"value":132,"toc":231},"minimark",[133,137,142,169,178,182,221],[134,135,136],"p",{},"Gateway Soft подключает GSM-модемы к серверу реселлера: читает каждую SIM-карту, выставляет её номер\nна продажу, принимает SMS для покупателей и пересылает их. Один аккаунт работает на любом числе\nкомпьютеров и телефонов.",[138,139,141],"h2",{"id":140},"выберите-редакцию","Выберите редакцию",[143,144,145,153,164],"card-group",{},[146,147,150],"card",{"icon":148,"title":149,"to":17},"i-lucide-monitor","Приложение для ПК",[134,151,152],{},"Windows, macOS, Linux. Полный интерфейс оператора в окне, со значком в трее и уведомлениями.",[146,154,156],{"icon":58,"title":155,"to":64},"Шлюз без окна",[134,157,158,159,163],{},"Та же установка, запущенная с ",[160,161,162],"code",{},"--serve",": без окна, Web UI в браузере. Для серверов и мини-ПК.",[146,165,166],{"icon":84,"title":83,"to":90},[134,167,168],{},"Android-приложение, которое продаёт SIM-карты самого телефона. Компьютер и USB-модем не нужны.",[134,170,171,172,177],{},"Все три берутся из одного ",[173,174,176],"a",{"href":175},"\u002Fru\u002Fdownloads","релиза"," и обновляются сами.",[138,179,181],{"id":180},"три-шага","Три шага",[183,184,186,190,200,204,207,211],"steps",{"level":185},"3",[187,188,16],"h3",{"id":189},"установка",[134,191,192,193,196,197,199],{},"Скачайте установщик для своей системы на ",[173,194,195],{"href":175},"странице загрузок"," и запустите его.\nПодробности по системам: ",[173,198,16],{"href":17},".",[187,201,203],{"id":202},"вход","Вход",[134,205,206],{},"Откройте приложение и войдите по email и паролю аккаунта продавца. Шлюз хранит сессию: после\nперезапуска он подключается сам.",[187,208,210],{"id":209},"добавление-модемов","Добавление модемов",[134,212,213,214,218,219,199],{},"Подключите модемы, откройте ",[215,216,217],"strong",{},"Список портов → Добавить"," и выберите их порты. С этого момента шлюз\nподключает их при каждом запуске, читает SIM-карты и выставляет номера на продажу. См.\n",[173,220,21],{"href":22},[222,223,224],"tip",{},[134,225,226,227,230],{},"Отдельную машину, на которой работает только шлюз, проще держать в сети как\n",[173,228,229],{"href":64},"шлюз без окна",", запущенный системной службой.",{"title":232,"searchDepth":233,"depth":233,"links":234},"",2,[235,236],{"id":140,"depth":233,"text":141},{"id":180,"depth":233,"text":181,"children":237},[238,240,241],{"id":189,"depth":239,"text":16},3,{"id":202,"depth":239,"text":203},{"id":209,"depth":239,"text":210},"Что такое Gateway Soft, какую редакцию установить и три шага до первого номера в продаже.","md",null,{},{"icon":14},{"title":11,"description":242},"WF8QY-FYOnXv4YtEqn_hoP7kHT18OPCTaop9d3efcEI",[244,250],{"title":16,"path":17,"description":251},"Установщики для Windows, macOS и Linux, какой файл выбрать и где шлюз хранит данные.",1794978318711]