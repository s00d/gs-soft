.serve","i-lucide-terminal",{"title":68,"path":69,"stem":70,"icon":71},"Web UI","\u002Fru\u002Fheadless\u002Fweb-ui","ru\u002F2.headless\u002F2.web-ui","i-lucide-globe",{"title":73,"path":74,"stem":75,"icon":76},"Запуск как служба","\u002Fru\u002Fheadless\u002Fservice","ru\u002F2.headless\u002F3.service","i-lucide-server-cog",{"title":78,"path":79,"stem":80,"icon":81},"Сетевые порты","\u002Fru\u002Fheadless\u002Fnetwork-ports","ru\u002F2.headless\u002F4.network-ports","i-lucide-network",{"title":83,"icon":84,"path":85,"stem":86,"children":87,"page":55},"Gateway Phone","i-lucide-smartphone","\u002Fru\u002Fphone","ru\u002F3.phone",[88,92],{"title":89,"path":90,"stem":91,"icon":84},"Обзор","\u002Fru\u002Fphone\u002Foverview","ru\u002F3.phone\u002F1.overview",{"title":93,"path":94,"stem":95,"icon":96},"Установка и настройка","\u002Fru\u002Fphone\u002Fsetup","ru\u002F3.phone\u002F2.setup","i-lucide-list-checks",{"title":98,"icon":81,"path":99,"stem":100,"children":101,"page":55},"Gateway Proxy","\u002Fru\u002Fproxy","ru\u002F4.proxy",[102,105],{"title":89,"path":103,"stem":104,"icon":81},"\u002Fru\u002Fproxy\u002Foverview","ru\u002F4.proxy\u002F1.overview",{"title":93,"path":106,"stem":107,"icon":96},"\u002Fru\u002Fproxy\u002Fsetup","ru\u002F4.proxy\u002F2.setup",{"title":109,"icon":110,"path":111,"stem":112,"children":113,"page":55},"Оборудование","i-lucide-cpu","\u002Fru\u002Fhardware","ru\u002F5.hardware",[114,118],{"title":115,"path":116,"stem":117,"icon":110},"Поддерживаемые модемы","\u002Fru\u002Fhardware\u002Fmodems","ru\u002F5.hardware\u002F1.modems",{"title":119,"path":120,"stem":121,"icon":122},"Драйверы","\u002Fru\u002Fhardware\u002Fdrivers","ru\u002F5.hardware\u002F2.drivers","i-lucide-usb",{"title":124,"path":125,"stem":126,"icon":127},"Вопросы и ответы","\u002Fru\u002Ffaq","ru\u002F6.faq","i-lucide-circle-help",{"id":129,"title":21,"body":130,"description":344,"extension":345,"links":346,"meta":347,"navigation":348,"path":22,"seo":349,"stem":23,"__hash__":350},"docs_ru\u002Fru\u002F1.guide\u002F3.modems.md",{"type":131,"value":132,"toc":337},"minimark",[133,143,148,173,180,198,202,205,285,289,292,330],[134,135,136],"p",{},[137,138],"img",{"alt":139,"className":140,"src":142},"Список портов с карточкой модема",[141],"prose-shot","\u002Fscreenshots\u002Fru\u002F02_modem_detail.png",[144,145,147],"h2",{"id":146},"добавление-портов","Добавление портов",[149,150,151,155,162],"ol",{},[152,153,154],"li",{},"Подключите модемы.",[152,156,157,161],{},[158,159,160],"strong",{},"Список портов → Добавить"," показывает ещё не занятые последовательные порты компьютера.\nСистемные порты (Bluetooth, отладочные консоли) скрыты.",[152,163,164,165,168,169,172],{},"Отметьте порты и нажмите ",[158,166,167],{},"Добавить"," или ",[158,170,171],{},"Добавить все порты",".",[134,174,175,176,179],{},"Добавленные порты запоминаются: шлюз подключает их при каждом запуске и каждый раз, когда модем\nснова вставляют в тот же USB-порт. ",[158,177,178],{},"Удалить из worked"," забывает порт.",[134,181,182,183,187,188,191,192,194,195,172],{},"Сетевые мосты для последовательных портов (",[184,185,186],"code",{},"tcp:\u002F\u002Fhost:port",") и адаптеры Bluetooth LE UART (",[184,189,190],{},"ble:\u002F\u002F…",")\nдобавляются на странице ",[158,193,109],{}," и затем появляются в том же списке. См.\n",[196,197,78],"a",{"href":79},[144,199,201],{"id":200},"список-портов","Список портов",[134,203,204],{},"В каждой строке — порт, оператор, номер, сигнал и статус. Фильтр над списком оставляет только\nдоступные, рабочие (worked), онлайн или проблемные порты. Выберите строку, чтобы открыть панель\nподробностей: имя и номер порта, данные SIM (IMSI, ICCID, IMEI, оператор, страна), доход и сервисы,\nкоторые использовали или заблокировали номер.",[206,207,208,221],"table",{},[209,210,211],"thead",{},[212,213,214,218],"tr",{},[215,216,217],"th",{},"Статус",[215,219,220],{},"Значение",[222,223,224,235,245,255,265,275],"tbody",{},[212,225,226,232],{},[227,228,229],"td",{},[158,230,231],{},"Онлайн",[227,233,234],{},"Номер в продаже.",[212,236,237,242],{},[227,238,239],{},[158,240,241],{},"В очереди",[227,243,244],{},"Номер отправлен на сервер и ждёт выставления на продажу.",[212,246,247,252],{},[227,248,249],{},[158,250,251],{},"Подключение",[227,253,254],{},"Шлюз прямо сейчас обменивается данными с модемом или сервером.",[212,256,257,262],{},[227,258,259],{},[158,260,261],{},"Офлайн",[227,263,264],{},"Модем работает, но номер не в продаже (автоподключение выключено, вход не выполнен).",[212,266,267,272],{},[227,268,269],{},[158,270,271],{},"Проблемы",[227,273,274],{},"Нужно внимание: что именно — написано в баннере панели подробностей.",[212,276,277,282],{},[227,278,279],{},[158,280,281],{},"Отключён",[227,283,284],{},"Модем не подключён или не отвечает.",[144,286,288],{"id":287},"действия-с-портом","Действия с портом",[134,290,291],{},"Щёлкните порт правой кнопкой (или используйте кнопки панели подробностей):",[293,294,295,301,307,313,319,325],"ul",{},[152,296,297,300],{},[158,298,299],{},"SMS на модеме"," — сообщения, полученные SIM-картой.",[152,302,303,306],{},[158,304,305],{},"LED-уведомление"," — мигает модемом, чтобы найти его в стойке.",[152,308,309,312],{},[158,310,311],{},"Сбросить ошибки и переподключить"," — очищает ошибки и снова выставляет номер; также выставляет на\nпродажу порт с известным номером без глобального автоподключения.",[152,314,315,318],{},[158,316,317],{},"Очистить номер"," — снимает номер с продажи и забывает его (новая SIM, смена номера).",[152,320,321,324],{},[158,322,323],{},"Показать ошибку"," — полный текст последней ошибки.",[152,326,327,329],{},[158,328,178],{}," — забыть порт.",[134,331,332,333,336],{},"Панель инструментов над списком отправляет USSD сразу на много портов (",[158,334,335],{},"Ещё → Массовый USSD",") и\nпроверяет состояние каждого модема.",{"title":338,"searchDepth":339,"depth":339,"links":340},"",2,[341,342,343],{"id":146,"depth":339,"text":147},{"id":200,"depth":339,"text":201},{"id":287,"depth":339,"text":288},"Добавление портов, список портов и что означает каждый статус.","md",null,{},{"icon":24},{"title":21,"description":344},"fQj0hOujLWScbF2M-rH04Cm1DNvBh18DlXcxzm_ZSo4",[352,354],{"title":16,"path":17,"description":353},"Установщики для Windows, macOS и Linux, какой файл выбрать и где шлюз хранит данные.",{"title":26,"path":27,"description":355},"Как SIM-карта становится номером в продаже, автоподключение, аренда и что означают ответы сервера.",1794978318895]